        <di:waypoint x="580" y="380" />
        <di:waypoint x="655" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PreflightToParallel_di" bpmnElement="Flow_PreflightToParallel">
        <di:waypoint x="755" y="380" />
