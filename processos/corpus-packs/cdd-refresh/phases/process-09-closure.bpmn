      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_StartToCompute_di" bpmnElement="Flow_StartToCompute">
        <di:waypoint x="273" y="380" />
        <di:waypoint x="355" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ComputeToPreflight_di" bpmnElement="Flow_ComputeToPreflight">
        <di:waypoint x="455" y="380" />
