      <bpmndi:BPMNShape id="EndEvent_RefreshComplete_di" bpmnElement="EndEvent_RefreshComplete">
        <dc:Bounds x="1287" y="362" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1262" y="398" width="87" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_DiagnosticMerge_di" bpmnElement="Gateway_DiagnosticMerge" isMarkerVisible="true">
