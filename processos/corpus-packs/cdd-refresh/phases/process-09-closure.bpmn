      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AnalystDiagnostic_di" bpmnElement="Task_AnalystDiagnostic">
        <dc:Bounds x="1255" y="480" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendRefreshComplete_di" bpmnElement="Task_SendRefreshComplete">
        <dc:Bounds x="955" y="207" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Association_TriggeredStart_di" bpmnElement="Association_TriggeredStart">
        <di:waypoint x="255" y="362" />
        <di:waypoint x="255" y="310" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Association_Preflight_di" bpmnElement="Association_Preflight">
        <di:waypoint x="705" y="340" />
        <di:waypoint x="705" y="290" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Association_Close_di" bpmnElement="Association_Close">
        <di:waypoint x="955" y="405" />
        <di:waypoint x="840" y="462" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Association_End_di" bpmnElement="Association_End">
        <di:waypoint x="1311" y="363" />
        <di:waypoint x="1328" y="312" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Association_Diagnostic_di" bpmnElement="Association_Diagnostic">
        <di:waypoint x="1324" y="560" />
        <di:waypoint x="1352" y="620" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Association_Notify_di" bpmnElement="Association_Notify">
        <di:waypoint x="1005" y="207" />
        <di:waypoint x="1005" y="181" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Association_NextRefresh_di" bpmnElement="Association_NextRefresh">
        <di:waypoint x="423" y="340" />
        <di:waypoint x="451" y="276" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="BoundaryEvent_ApprovalNotComplete_di" bpmnElement="BoundaryEvent_ApprovalNotComplete">
        <dc:Bounds x="1014" y="402" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1039" y="438" width="82" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BoundaryEvent_MissingDocs_di" bpmnElement="BoundaryEvent_MissingDocs">
        <dc:Bounds x="960" y="402" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="899" y="450" width="82" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Annotation_Triggered_di" bpmnElement="Annotation_Triggered">
        <dc:Bounds x="155" y="224" width="200" height="86" />
      </bpmndi:BPMNShape>
