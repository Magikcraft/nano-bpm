      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_PreflightMerge_di" bpmnElement="Gateway_PreflightMerge" isMarkerVisible="true">
        <dc:Bounds x="530" y="355" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_PreflightValidation_di" bpmnElement="Task_PreflightValidation">
