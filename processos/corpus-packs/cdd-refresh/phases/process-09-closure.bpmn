<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_Process09" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.46.1">
  <bpmn:error id="Error_MissingDocs" name="MISSING_REQUIRED_DOCUMENTS" errorCode="MISSING_REQUIRED_DOCUMENTS" />
  <bpmn:error id="Error_ApprovalNotComplete" name="APPROVAL_NOT_COMPLETE" errorCode="APPROVAL_NOT_COMPLETE" />
  <bpmn:process id="Process09Closure" name="Phase 9: Case Closure and Refresh Complete Notification" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Approved" name="Case approved">
      <bpmn:outgoing>Flow_StartToCompute</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_ComputeNextRefresh" name="Compute next refresh due date">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="compute-next-refresh-due-date" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_StartToCompute</bpmn:incoming>
      <bpmn:outgoing>Flow_ComputeToPreflight</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_PreflightMerge" name="">
      <bpmn:incoming>Flow_ComputeToPreflight</bpmn:incoming>
      <bpmn:incoming>Flow_DiagnosticToPreflight</bpmn:incoming>
      <bpmn:outgoing>Flow_MergeToPreflight</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_PreflightValidation" name="Pre-flight close validation">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="pre-flight-close-validation" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_MergeToPreflight</bpmn:incoming>
      <bpmn:outgoing>Flow_PreflightToParallel</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_ParallelSplit" name="">
      <bpmn:incoming>Flow_PreflightToParallel</bpmn:incoming>
      <bpmn:outgoing>Flow_ParallelToClose</bpmn:outgoing>
      <bpmn:outgoing>Flow_ParallelToNotify</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_CloseCase" name="Close CDD case">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="close-cdd-case" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ParallelToClose</bpmn:incoming>
      <bpmn:outgoing>Flow_CloseToJoin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SendRefreshComplete" name="Send REFRESH_COMPLETE notification">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-refresh-complete-notification" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ParallelToNotify</bpmn:incoming>
      <bpmn:outgoing>Flow_NotifyToJoin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="Gateway_ParallelJoin" name="">
      <bpmn:incoming>Flow_CloseToJoin</bpmn:incoming>
      <bpmn:incoming>Flow_NotifyToJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_JoinToEnd</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:endEvent id="EndEvent_RefreshComplete" name="Refresh complete">
      <bpmn:incoming>Flow_JoinToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="BoundaryEvent_MissingDocs" name="MISSING_REQUIRED_DOCUMENTS" attachedToRef="Task_CloseCase">
      <bpmn:outgoing>Flow_MissingDocsToDiagnostic</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_MissingDocs" errorRef="Error_MissingDocs" />
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="BoundaryEvent_ApprovalNotComplete" name="APPROVAL_NOT_COMPLETE" attachedToRef="Task_CloseCase">
      <bpmn:outgoing>Flow_ApprovalNotCompleteToDiagnostic</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_ApprovalNotComplete" errorRef="Error_ApprovalNotComplete" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Gateway_DiagnosticMerge" name="">
      <bpmn:incoming>Flow_MissingDocsToDiagnostic</bpmn:incoming>
      <bpmn:incoming>Flow_ApprovalNotCompleteToDiagnostic</bpmn:incoming>
      <bpmn:outgoing>Flow_MergeToDiagnostic</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_AnalystDiagnostic" name="Resolve close-time precondition">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-analyst-diagnostic" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_MergeToDiagnostic</bpmn:incoming>
      <bpmn:outgoing>Flow_DiagnosticToPreflight</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sequenceFlow id="Flow_StartToCompute" sourceRef="StartEvent_Approved" targetRef="Task_ComputeNextRefresh" />
    <bpmn:sequenceFlow id="Flow_ComputeToPreflight" sourceRef="Task_ComputeNextRefresh" targetRef="Gateway_PreflightMerge" />
    <bpmn:sequenceFlow id="Flow_MergeToPreflight" sourceRef="Gateway_PreflightMerge" targetRef="Task_PreflightValidation" />
    <bpmn:sequenceFlow id="Flow_PreflightToParallel" sourceRef="Task_PreflightValidation" targetRef="Gateway_ParallelSplit" />
    <bpmn:sequenceFlow id="Flow_ParallelToClose" sourceRef="Gateway_ParallelSplit" targetRef="Task_CloseCase" />
    <bpmn:sequenceFlow id="Flow_ParallelToNotify" sourceRef="Gateway_ParallelSplit" targetRef="Task_SendRefreshComplete" />
    <bpmn:sequenceFlow id="Flow_CloseToJoin" sourceRef="Task_CloseCase" targetRef="Gateway_ParallelJoin" />
    <bpmn:sequenceFlow id="Flow_NotifyToJoin" sourceRef="Task_SendRefreshComplete" targetRef="Gateway_ParallelJoin" />
    <bpmn:sequenceFlow id="Flow_JoinToEnd" sourceRef="Gateway_ParallelJoin" targetRef="EndEvent_RefreshComplete" />
    <bpmn:sequenceFlow id="Flow_MissingDocsToDiagnostic" sourceRef="BoundaryEvent_MissingDocs" targetRef="Gateway_DiagnosticMerge" />
    <bpmn:sequenceFlow id="Flow_ApprovalNotCompleteToDiagnostic" sourceRef="BoundaryEvent_ApprovalNotComplete" targetRef="Gateway_DiagnosticMerge" />
    <bpmn:sequenceFlow id="Flow_MergeToDiagnostic" sourceRef="Gateway_DiagnosticMerge" targetRef="Task_AnalystDiagnostic" />
    <bpmn:sequenceFlow id="Flow_DiagnosticToPreflight" sourceRef="Task_AnalystDiagnostic" targetRef="Gateway_PreflightMerge" />
    <bpmn:textAnnotation id="Annotation_Triggered">
      <bpmn:text>Triggered by: Phase 8 approval — case.status=APPROVED, approverUsername+approvalDate set</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_TriggeredStart" sourceRef="StartEvent_Approved" targetRef="Annotation_Triggered" />
    <bpmn:textAnnotation id="Annotation_NextRefresh">
      <bpmn:text>Implementation: nextRefreshDueDate = approvalDate + refreshCycleYears (DMN output)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_NextRefresh" sourceRef="Task_ComputeNextRefresh" targetRef="Annotation_NextRefresh" />
    <bpmn:textAnnotation id="Annotation_Preflight">
      <bpmn:text>Implementation: validates DocuSafe completeness + newRiskTier + approverUsername populated; raises blocking error if not. Closes FCA Q4 2024 finding on missing approver fields.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Preflight" sourceRef="Task_PreflightValidation" targetRef="Annotation_Preflight" />
    <bpmn:textAnnotation id="Annotation_Close">
      <bpmn:text>Implementation: ClientVault POST /cdd-cases/{caseId}/close — outcome=REFRESH_COMPLETE, nextRefreshDueDate, closingNotes</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Close" sourceRef="Task_CloseCase" targetRef="Annotation_Close" />
    <bpmn:textAnnotation id="Annotation_Notify">
      <bpmn:text>Implementation: Notification Service POST /notifications template=REFRESH_COMPLETE — gated by clientCommsFreeze; auto-CC RM, auto-log to ClientVault</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Notify" sourceRef="Task_SendRefreshComplete" targetRef="Annotation_Notify" />
    <bpmn:textAnnotation id="Annotation_Diagnostic">
      <bpmn:text>Manual: analyst diagnoses which precondition failed (DocuSafe completeness vs newRiskTier vs approverUsername) and remediates; loops back to pre-flight</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Diagnostic" sourceRef="Task_AnalystDiagnostic" targetRef="Annotation_Diagnostic" />
    <bpmn:textAnnotation id="Annotation_End">
      <bpmn:text>Follow-up: case.status=CLOSED with outcome REFRESH_COMPLETE; ClientVault audit trail closed (5y retention per MLR 2017 reg. 40); next batch trigger seeds at refreshDueDate-30d</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_End" sourceRef="EndEvent_RefreshComplete" targetRef="Annotation_End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process09Closure">
    <bpmndi:BPMNPlane id="BPMNPlane_Process09Closure" bpmnElement="Process09Closure">
      <bpmndi:BPMNShape id="StartEvent_Approved_di" bpmnElement="StartEvent_Approved">
        <dc:Bounds x="237" y="362" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="218" y="398" width="75" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ComputeNextRefresh_di" bpmnElement="Task_ComputeNextRefresh">
