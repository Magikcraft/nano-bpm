<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.46.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:message id="Message_RefreshBatch" name="RefreshBatchTriggered">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=clientId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:error id="Error_ClientNotFound" name="CLIENT_NOT_FOUND" errorCode="CLIENT_NOT_FOUND" />
  <bpmn:error id="Error_DuplicateOpenCase" name="DUPLICATE_OPEN_CASE" errorCode="DUPLICATE_OPEN_CASE" />
  <bpmn:process id="Process01IntakeProcess" name="Phase 1: Case Intake and Duplicate Check" isExecutable="true">
    <bpmn:startEvent id="StartEvent_RefreshBatch" name="Refresh batch received">
      <bpmn:outgoing>Flow_RefreshBatchToMerge</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_RefreshBatch" messageRef="Message_RefreshBatch" />
    </bpmn:startEvent>
    <bpmn:startEvent id="StartEvent_ManualIntake" name="Manual case intake submitted">
      <bpmn:outgoing>Flow_ManualIntakeToMerge</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_StartMerge" name="">
      <bpmn:incoming>Flow_RefreshBatchToMerge</bpmn:incoming>
      <bpmn:incoming>Flow_ManualIntakeToMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_MergeToGetProfile</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_GetClientProfile" name="Get client profile" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="headers" target="authentication.apiKeyLocation" />
          <zeebe:input target="authentication.name" />
          <zeebe:input target="authentication.value" />
          <zeebe:input target="authentication.username" />
          <zeebe:input target="authentication.password" />
          <zeebe:input target="authentication.token" />
          <zeebe:input target="authentication.oauthTokenEndpoint" />
          <zeebe:input target="authentication.clientId" />
          <zeebe:input target="authentication.clientSecret" />
          <zeebe:input target="authentication.audience" />
          <zeebe:input target="authentication.clientAuthentication" />
          <zeebe:input target="authentication.scopes" />
          <zeebe:input source="GET" target="method" />
          <zeebe:input source="=&quot;https://clientvault.meridian.local/clients/&quot; + clientId" target="url" />
          <zeebe:input target="headers" />
          <zeebe:input target="queryParameters" />
          <zeebe:input target="storeResponse" />
          <zeebe:input target="skipEncoding" />
          <zeebe:input target="followRedirects" />
          <zeebe:input target="connectionTimeoutInSeconds" />
          <zeebe:input target="readTimeoutInSeconds" />
          <zeebe:input target="body" />
          <zeebe:input target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="13" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={ legalName: body.legalName, companiesHouseNumber: body.companiesHouseNumber, jurisdiction: body.jurisdiction, priorRiskTier: body.priorRiskTier, assignedRm: body.assignedRm, assignedAnalyst: body.assignedAnalyst, pepStatus: body.pepStatus }" />
          <zeebe:header key="errorExpression" value="=if response.statusCode = 404 then bpmnError(&quot;CLIENT_NOT_FOUND&quot;, &quot;Client not found&quot;) else null" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_MergeToGetProfile</bpmn:incoming>
      <bpmn:outgoing>Flow_GetProfileToOpenCase</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_ClientNotFound" name="Client not found" attachedToRef="Task_GetClientProfile">
      <bpmn:outgoing>Flow_ClientNotFoundToEnd</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_ClientNotFound" errorRef="Error_ClientNotFound" />
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_OpenCddCase" name="Open CDD case" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="headers" target="authentication.apiKeyLocation" />
          <zeebe:input target="authentication.name" />
          <zeebe:input target="authentication.value" />
          <zeebe:input target="authentication.username" />
          <zeebe:input target="authentication.password" />
          <zeebe:input target="authentication.token" />
          <zeebe:input target="authentication.oauthTokenEndpoint" />
          <zeebe:input target="authentication.clientId" />
          <zeebe:input target="authentication.clientSecret" />
          <zeebe:input target="authentication.audience" />
          <zeebe:input target="authentication.clientAuthentication" />
          <zeebe:input target="authentication.scopes" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=&quot;https://clientvault.meridian.local/clients/&quot; + clientId + &quot;/cdd-cases&quot;" target="url" />
          <zeebe:input target="headers" />
          <zeebe:input target="queryParameters" />
          <zeebe:input target="storeResponse" />
          <zeebe:input target="skipEncoding" />
          <zeebe:input target="followRedirects" />
          <zeebe:input target="connectionTimeoutInSeconds" />
          <zeebe:input target="readTimeoutInSeconds" />
          <zeebe:input source="={ clientId: clientId, triggerType: triggerType, triggerReason: triggerReason }" target="body" />
          <zeebe:input target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="13" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={ caseId: body.caseId, caseStatus: body.case.status }" />
          <zeebe:header key="errorExpression" value="=if response.statusCode = 409 then bpmnError(&quot;DUPLICATE_OPEN_CASE&quot;, &quot;Duplicate open case&quot;) else null" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_GetProfileToOpenCase</bpmn:incoming>
      <bpmn:outgoing>Flow_OpenCaseToSplit</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="Boundary_DuplicateOpenCase" name="Duplicate open case" attachedToRef="Task_OpenCddCase">
      <bpmn:outgoing>Flow_DuplicateToEnd</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_DuplicateOpenCase" errorRef="Error_DuplicateOpenCase" />
    </bpmn:boundaryEvent>
    <bpmn:parallelGateway id="ParallelGateway_Split_1" name="">
      <bpmn:incoming>Flow_OpenCaseToSplit</bpmn:incoming>
      <bpmn:outgoing>Flow_SplitToHeadsup</bpmn:outgoing>
      <bpmn:outgoing>Flow_SplitToConfirmAnalyst</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_SendRmHeadsup" name="Send RM heads-up" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="headers" target="authentication.apiKeyLocation" />
          <zeebe:input target="authentication.name" />
          <zeebe:input target="authentication.value" />
          <zeebe:input target="authentication.username" />
          <zeebe:input target="authentication.password" />
          <zeebe:input target="authentication.token" />
          <zeebe:input target="authentication.oauthTokenEndpoint" />
          <zeebe:input target="authentication.clientId" />
          <zeebe:input target="authentication.clientSecret" />
          <zeebe:input target="authentication.audience" />
          <zeebe:input target="authentication.clientAuthentication" />
          <zeebe:input target="authentication.scopes" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=&quot;https://notification.meridian.local/notifications&quot;" target="url" />
          <zeebe:input target="headers" />
          <zeebe:input target="queryParameters" />
          <zeebe:input target="storeResponse" />
          <zeebe:input target="skipEncoding" />
          <zeebe:input target="followRedirects" />
          <zeebe:input target="connectionTimeoutInSeconds" />
          <zeebe:input target="readTimeoutInSeconds" />
          <zeebe:input source="={ template: &quot;RM_CDD_HEADSUP&quot;, caseId: caseId, clientLegalName: legalName, expectedDocumentRequestDate: expectedDocumentRequestDate, deadlineDays: 21, ccRm: assignedRm }" target="body" />
          <zeebe:input target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="13" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SplitToHeadsup</bpmn:incoming>
      <bpmn:outgoing>Flow_HeadsupToJoin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_ConfirmAnalystAssignment" name="Confirm KYC analyst and conflict-of-interest declaration">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-confirm-analyst-assignment" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SplitToConfirmAnalyst</bpmn:incoming>
      <bpmn:outgoing>Flow_ConfirmAnalystToPersist</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_PersistAnalystAssignment" name="Persist analyst assignment" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="headers" target="authentication.apiKeyLocation" />
          <zeebe:input target="authentication.name" />
          <zeebe:input target="authentication.value" />
          <zeebe:input target="authentication.username" />
          <zeebe:input target="authentication.password" />
          <zeebe:input target="authentication.token" />
          <zeebe:input target="authentication.oauthTokenEndpoint" />
          <zeebe:input target="authentication.clientId" />
          <zeebe:input target="authentication.clientSecret" />
          <zeebe:input target="authentication.audience" />
          <zeebe:input target="authentication.clientAuthentication" />
          <zeebe:input target="authentication.scopes" />
          <zeebe:input source="PATCH" target="method" />
          <zeebe:input source="=&quot;https://clientvault.meridian.local/cdd-cases/&quot; + caseId" target="url" />
          <zeebe:input target="headers" />
          <zeebe:input target="queryParameters" />
          <zeebe:input target="storeResponse" />
          <zeebe:input target="skipEncoding" />
          <zeebe:input target="followRedirects" />
          <zeebe:input target="connectionTimeoutInSeconds" />
          <zeebe:input target="readTimeoutInSeconds" />
          <zeebe:input source="={ assignedAnalyst: assignedAnalyst }" target="body" />
          <zeebe:input target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="13" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ConfirmAnalystToPersist</bpmn:incoming>
      <bpmn:outgoing>Flow_PersistToJoin</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ParallelGateway_Join_1" name="">
      <bpmn:incoming>Flow_HeadsupToJoin</bpmn:incoming>
      <bpmn:incoming>Flow_PersistToJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_JoinToTransition</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_TransitionStatusToPendingDocs" name="Transition status to pending documents" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="headers" target="authentication.apiKeyLocation" />
          <zeebe:input target="authentication.name" />
          <zeebe:input target="authentication.value" />
          <zeebe:input target="authentication.username" />
          <zeebe:input target="authentication.password" />
          <zeebe:input target="authentication.token" />
          <zeebe:input target="authentication.oauthTokenEndpoint" />
          <zeebe:input target="authentication.clientId" />
          <zeebe:input target="authentication.clientSecret" />
          <zeebe:input target="authentication.audience" />
          <zeebe:input target="authentication.clientAuthentication" />
          <zeebe:input target="authentication.scopes" />
          <zeebe:input source="PATCH" target="method" />
          <zeebe:input source="=&quot;https://clientvault.meridian.local/cdd-cases/&quot; + caseId" target="url" />
          <zeebe:input target="headers" />
          <zeebe:input target="queryParameters" />
          <zeebe:input target="storeResponse" />
          <zeebe:input target="skipEncoding" />
          <zeebe:input target="followRedirects" />
          <zeebe:input target="connectionTimeoutInSeconds" />
          <zeebe:input target="readTimeoutInSeconds" />
          <zeebe:input source="={ status: &quot;PENDING_DOCUMENTS&quot; }" target="body" />
          <zeebe:input target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="13" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_JoinToTransition</bpmn:incoming>
      <bpmn:outgoing>Flow_TransitionToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_PendingDocuments" name="Case pending documents">
      <bpmn:incoming>Flow_TransitionToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_ClientNotFound" name="Client not found">
      <bpmn:incoming>Flow_ClientNotFoundToEnd</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_ClientNotFoundEnd" errorRef="Error_ClientNotFound" />
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_CaseDuplicateResumed" name="Duplicate case resumed">
      <bpmn:incoming>Flow_DuplicateToEnd</bpmn:incoming>
      <bpmn:errorEventDefinition id="ErrorEventDefinition_DuplicateEnd" errorRef="Error_DuplicateOpenCase" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_RefreshBatchToMerge" sourceRef="StartEvent_RefreshBatch" targetRef="Gateway_StartMerge" />
    <bpmn:sequenceFlow id="Flow_ManualIntakeToMerge" sourceRef="StartEvent_ManualIntake" targetRef="Gateway_StartMerge" />
    <bpmn:sequenceFlow id="Flow_MergeToGetProfile" sourceRef="Gateway_StartMerge" targetRef="Task_GetClientProfile" />
    <bpmn:sequenceFlow id="Flow_GetProfileToOpenCase" sourceRef="Task_GetClientProfile" targetRef="Task_OpenCddCase" />
    <bpmn:sequenceFlow id="Flow_ClientNotFoundToEnd" sourceRef="Boundary_ClientNotFound" targetRef="EndEvent_ClientNotFound" />
    <bpmn:sequenceFlow id="Flow_OpenCaseToSplit" sourceRef="Task_OpenCddCase" targetRef="ParallelGateway_Split_1" />
    <bpmn:sequenceFlow id="Flow_DuplicateToEnd" sourceRef="Boundary_DuplicateOpenCase" targetRef="EndEvent_CaseDuplicateResumed" />
    <bpmn:sequenceFlow id="Flow_SplitToHeadsup" sourceRef="ParallelGateway_Split_1" targetRef="Task_SendRmHeadsup" />
    <bpmn:sequenceFlow id="Flow_SplitToConfirmAnalyst" sourceRef="ParallelGateway_Split_1" targetRef="Task_ConfirmAnalystAssignment" />
    <bpmn:sequenceFlow id="Flow_ConfirmAnalystToPersist" sourceRef="Task_ConfirmAnalystAssignment" targetRef="Task_PersistAnalystAssignment" />
    <bpmn:sequenceFlow id="Flow_HeadsupToJoin" sourceRef="Task_SendRmHeadsup" targetRef="ParallelGateway_Join_1" />
    <bpmn:sequenceFlow id="Flow_PersistToJoin" sourceRef="Task_PersistAnalystAssignment" targetRef="ParallelGateway_Join_1" />
    <bpmn:sequenceFlow id="Flow_JoinToTransition" sourceRef="ParallelGateway_Join_1" targetRef="Task_TransitionStatusToPendingDocs" />
    <bpmn:sequenceFlow id="Flow_TransitionToEnd" sourceRef="Task_TransitionStatusToPendingDocs" targetRef="EndEvent_PendingDocuments" />
    <bpmn:textAnnotation id="TextAnnotation_RefreshBatchStart">
      <bpmn:text>Triggered by: ClientVault batch scheduler (per-client message with clientId, triggerType PERIODIC|EVENT_DRIVEN, optional triggerReason)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_ManualIntakeStart">
      <bpmn:text>Triggered by: KYC Analyst submitting Camunda Form for manual intake</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_GetClientProfile">
      <bpmn:text>Implementation: ClientVault GET /clients/{clientId}; auth X-API-Key from secrets.CLIENTVAULT_API_KEY; returns legalName, companiesHouseNumber, jurisdiction, priorRiskTier, assignedRm, assignedAnalyst, pepStatus</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_OpenCddCase">
      <bpmn:text>Implementation: ClientVault POST /clients/{clientId}/cdd-cases with clientId, triggerType, triggerReason; returns caseId and case.status DRAFT; HTTP 409 raises DUPLICATE_OPEN_CASE</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_SendRmHeadsup">
      <bpmn:text>Implementation: Notification Service POST /notifications template RM_CDD_HEADSUP with caseId, clientLegalName, expectedDocumentRequestDate, deadlineDays 21; auto-CCs assigned RM</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_ConfirmAnalystAssignment">
      <bpmn:text>Manual: Conflict-of-interest declaration is policy-only and has no API surface; KYC Team Lead must affirmatively attest analyst assignment for audit trail</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_PersistAnalystAssignment">
      <bpmn:text>Implementation: ClientVault PATCH /cdd-cases/{caseId} with body assignedAnalyst; idempotent retryable write splits the audit log entry off the user task</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_TransitionStatus">
      <bpmn:text>Implementation: ClientVault PATCH /cdd-cases/{caseId} with body status PENDING_DOCUMENTS; recorded as discrete audit-log entry per Hard Constraint 12</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_PendingDocumentsEnd">
      <bpmn:text>Follow-up: Phase 2 document collection begins with caseId, clientId, assignedAnalyst, notificationId in scope</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_ClientNotFoundEnd">
      <bpmn:text>Follow-up: Terminate intake; SYSTEM case note recorded; no downstream phase invoked</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_DuplicateResumedEnd">
      <bpmn:text>Follow-up: Existing case resumed; SYSTEM case note "Duplicate intake — resumed {existingCaseId}"; no new phase instance</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_RefreshBatchStart" sourceRef="StartEvent_RefreshBatch" targetRef="TextAnnotation_RefreshBatchStart" />
    <bpmn:association id="Association_ManualIntakeStart" sourceRef="StartEvent_ManualIntake" targetRef="TextAnnotation_ManualIntakeStart" />
    <bpmn:association id="Association_GetClientProfile" sourceRef="Task_GetClientProfile" targetRef="TextAnnotation_GetClientProfile" />
    <bpmn:association id="Association_OpenCddCase" sourceRef="Task_OpenCddCase" targetRef="TextAnnotation_OpenCddCase" />
    <bpmn:association id="Association_SendRmHeadsup" sourceRef="Task_SendRmHeadsup" targetRef="TextAnnotation_SendRmHeadsup" />
    <bpmn:association id="Association_ConfirmAnalystAssignment" sourceRef="Task_ConfirmAnalystAssignment" targetRef="TextAnnotation_ConfirmAnalystAssignment" />
    <bpmn:association id="Association_PersistAnalystAssignment" sourceRef="Task_PersistAnalystAssignment" targetRef="TextAnnotation_PersistAnalystAssignment" />
    <bpmn:association id="Association_TransitionStatus" sourceRef="Task_TransitionStatusToPendingDocs" targetRef="TextAnnotation_TransitionStatus" />
    <bpmn:association id="Association_PendingDocumentsEnd" sourceRef="EndEvent_PendingDocuments" targetRef="TextAnnotation_PendingDocumentsEnd" />
    <bpmn:association id="Association_ClientNotFoundEnd" sourceRef="EndEvent_ClientNotFound" targetRef="TextAnnotation_ClientNotFoundEnd" />
    <bpmn:association id="Association_DuplicateResumedEnd" sourceRef="EndEvent_CaseDuplicateResumed" targetRef="TextAnnotation_DuplicateResumedEnd" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process01IntakeProcess">
    <bpmndi:BPMNPlane id="BPMNPlane_Process01IntakeProcess" bpmnElement="Process01IntakeProcess">
      <bpmndi:BPMNShape id="StartEvent_RefreshBatch_di" bpmnElement="StartEvent_RefreshBatch">
        <dc:Bounds x="57" y="52" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_StartMerge_di" bpmnElement="Gateway_StartMerge" isMarkerVisible="true">
        <dc:Bounds x="200" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_GetClientProfile_di" bpmnElement="Task_GetClientProfile">
        <dc:Bounds x="325" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_ClientNotFound_di" bpmnElement="Boundary_ClientNotFound">
        <dc:Bounds x="357" y="92" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_OpenCddCase_di" bpmnElement="Task_OpenCddCase">
        <dc:Bounds x="475" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_DuplicateOpenCase_di" bpmnElement="Boundary_DuplicateOpenCase">
        <dc:Bounds x="507" y="92" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ParallelGateway_Split_1_di" bpmnElement="ParallelGateway_Split_1">
        <dc:Bounds x="650" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SendRmHeadsup_di" bpmnElement="Task_SendRmHeadsup">
        <dc:Bounds x="775" y="30" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ParallelGateway_Join_1_di" bpmnElement="ParallelGateway_Join_1">
        <dc:Bounds x="1100" y="45" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_TransitionStatusToPendingDocs_di" bpmnElement="Task_TransitionStatusToPendingDocs">
