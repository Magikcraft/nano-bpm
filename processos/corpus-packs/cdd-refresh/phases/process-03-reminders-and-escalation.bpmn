<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.46.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:message id="Message_DocumentsReceived" name="DocumentsReceived">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=caseId" />
    </bpmn:extensionElements>
  </bpmn:message>
  <bpmn:process id="Process03RemindersAndEscalationProcess" name="Reminders and non-response escalation" isExecutable="true">
    <bpmn:startEvent id="StartEvent_DocumentRequestIssued" name="Document request issued">
      <bpmn:outgoing>Flow_StartToWait</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:subProcess id="SubProcess_WaitForDocuments" name="Wait for documents">
      <bpmn:incoming>Flow_StartToWait</bpmn:incoming>
      <bpmn:outgoing>Flow_WaitToDocsReceived</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent_WaitInner" name="Wait state entered">
        <bpmn:outgoing>Flow_InnerStartToReceive</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:receiveTask id="Task_ReceiveDocuments" name="Receive documents" messageRef="Message_DocumentsReceived">
        <bpmn:incoming>Flow_InnerStartToReceive</bpmn:incoming>
        <bpmn:outgoing>Flow_ReceiveToInnerEnd</bpmn:outgoing>
      </bpmn:receiveTask>
      <bpmn:endEvent id="EndEvent_WaitInner" name="Documents received">
        <bpmn:incoming>Flow_ReceiveToInnerEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_InnerStartToReceive" sourceRef="StartEvent_WaitInner" targetRef="Task_ReceiveDocuments" />
      <bpmn:sequenceFlow id="Flow_ReceiveToInnerEnd" sourceRef="Task_ReceiveDocuments" targetRef="EndEvent_WaitInner" />
    </bpmn:subProcess>
    <bpmn:boundaryEvent id="BoundaryEvent_Day7Timer" name="Day 7" cancelActivity="false" attachedToRef="SubProcess_WaitForDocuments">
      <bpmn:outgoing>Flow_Day7TimerOut</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_Day7">
        <bpmn:timeDuration>P7D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="BoundaryEvent_Day14Timer" name="Day 14" cancelActivity="false" attachedToRef="SubProcess_WaitForDocuments">
      <bpmn:outgoing>Flow_Day14TimerOut</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_Day14">
        <bpmn:timeDuration>P14D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="BoundaryEvent_Day21Timer" name="Day 21" cancelActivity="false" attachedToRef="SubProcess_WaitForDocuments">
      <bpmn:outgoing>Flow_Day21TimerOut</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_Day21">
        <bpmn:timeDuration>P21D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="BoundaryEvent_Day35Timer" name="Day 35" attachedToRef="SubProcess_WaitForDocuments">
      <bpmn:outgoing>Flow_Day35TimerOut</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_Day35">
        <bpmn:timeDuration>P35D</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_Send7DayReminder" name="Send 7-day reminder" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="bearer" target="authentication.type" />
          <zeebe:input source="headers" target="authentication.apiKeyLocation" />
          <zeebe:input target="authentication.name" />
          <zeebe:input target="authentication.value" />
          <zeebe:input target="authentication.username" />
          <zeebe:input target="authentication.password" />
          <zeebe:input source="{{secrets.NOTIFICATION_SERVICE_TOKEN}}" target="authentication.token" />
          <zeebe:input target="authentication.oauthTokenEndpoint" />
          <zeebe:input target="authentication.clientId" />
          <zeebe:input target="authentication.clientSecret" />
          <zeebe:input target="authentication.audience" />
          <zeebe:input target="authentication.clientAuthentication" />
          <zeebe:input target="authentication.scopes" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=notificationServiceBaseUrl + &#34;/notifications&#34;" target="url" />
          <zeebe:input target="headers" />
          <zeebe:input target="queryParameters" />
          <zeebe:input target="storeResponse" />
          <zeebe:input target="skipEncoding" />
          <zeebe:input target="followRedirects" />
          <zeebe:input target="connectionTimeoutInSeconds" />
          <zeebe:input target="readTimeoutInSeconds" />
          <zeebe:input source="={ template: &#34;CDD_REMINDER_7DAY&#34;, caseId: caseId, recipient: clientPrimaryContactEmail, variables: { clientLegalName: clientLegalName, deadline: deadline, uploadLink: uploadLink }, gateClientCommsFreeze: clientCommsFreeze }" target="body" />
          <zeebe:input target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="13" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={ notificationId: body.notificationId, deliveryStatus: body.deliveryStatus }" />
          <zeebe:header key="errorExpression" value="=if error.code = &#34;502&#34; or error.code = &#34;503&#34; or error.code = &#34;504&#34; then bpmnError(&#34;NOTIFICATION_SERVICE_DOWN&#34;, &#34;Notification service unavailable&#34;) else null" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Day7TimerOut</bpmn:incoming>
      <bpmn:outgoing>Flow_Send7ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Reminder7Sent" name="7-day reminder sent">
      <bpmn:incoming>Flow_Send7ToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_DraftReminder14Body" name="Draft 14-day reminder body" zeebe:modelerTemplate="io.camunda.connectors.aws.bedrock.v1" zeebe:modelerTemplateVersion="3" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:aws-bedrock:1" />
        <zeebe:ioMapping>
          <zeebe:input source="credentials" target="authentication.type" />
          <zeebe:input source="{{secrets.AWS_ACCESS_KEY_ID}}" target="authentication.accessKey" />
          <zeebe:input source="{{secrets.AWS_SECRET_ACCESS_KEY}}" target="authentication.secretKey" />
          <zeebe:input source="{{secrets.AWS_REGION}}" target="configuration.region" />
          <zeebe:input target="configuration.endpoint" />
          <zeebe:input source="invokeModel" target="action" />
          <zeebe:input target="data.modelId" />
          <zeebe:input target="data.payload" />
          <zeebe:input target="data.messagesHistory" />
          <zeebe:input target="data.newMessage" />
          <zeebe:input target="data.maxTokens" />
          <zeebe:input target="data.temperature" />
          <zeebe:input target="data.topP" />
          <zeebe:input target="data.newDocuments" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="3" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.aws.bedrock.v1" />
          <zeebe:header key="resultExpression" value="={ reminderBody: body.content[1].text, aiConfidence: body.confidence, tcfLanguageFlags: body.tcfLanguageFlags, aiUncertaintyNote: if body.confidence &#60; 0.90 then &#34;AI confidence below auto-populate threshold&#34; else null }" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Day14TimerOut</bpmn:incoming>
      <bpmn:outgoing>Flow_DraftToApprove</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_ApproveReminder14" name="Approve 14-day reminder">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-approve-reminder-14" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_DraftToApprove</bpmn:incoming>
      <bpmn:outgoing>Flow_ApproveToGateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Reminder14Approved" name="Reminder approved?" default="SequenceFlow_Reminder14Yes">
      <bpmn:incoming>Flow_ApproveToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_Reminder14Yes</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Reminder14No</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Send14DayReminder" name="Send 14-day reminder" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="bearer" target="authentication.type" />
          <zeebe:input source="headers" target="authentication.apiKeyLocation" />
          <zeebe:input target="authentication.name" />
          <zeebe:input target="authentication.value" />
          <zeebe:input target="authentication.username" />
          <zeebe:input target="authentication.password" />
          <zeebe:input source="{{secrets.NOTIFICATION_SERVICE_TOKEN}}" target="authentication.token" />
          <zeebe:input target="authentication.oauthTokenEndpoint" />
          <zeebe:input target="authentication.clientId" />
          <zeebe:input target="authentication.clientSecret" />
          <zeebe:input target="authentication.audience" />
          <zeebe:input target="authentication.clientAuthentication" />
          <zeebe:input target="authentication.scopes" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=notificationServiceBaseUrl + &#34;/notifications&#34;" target="url" />
          <zeebe:input target="headers" />
          <zeebe:input target="queryParameters" />
          <zeebe:input target="storeResponse" />
          <zeebe:input target="skipEncoding" />
          <zeebe:input target="followRedirects" />
          <zeebe:input target="connectionTimeoutInSeconds" />
          <zeebe:input target="readTimeoutInSeconds" />
          <zeebe:input source="={ template: &#34;CDD_REMINDER_14DAY&#34;, caseId: caseId, recipient: clientPrimaryContactEmail, variables: { clientLegalName: clientLegalName, deadline: deadline, uploadLink: uploadLink, reminderBody: reminderBody }, refreshUploadLink: true, gateClientCommsFreeze: clientCommsFreeze }" target="body" />
          <zeebe:input target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="13" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={ notificationId: body.notificationId, deliveryStatus: body.deliveryStatus, uploadLink: body.uploadLink }" />
          <zeebe:header key="errorExpression" value="=if error.code = &#34;502&#34; or error.code = &#34;503&#34; or error.code = &#34;504&#34; then bpmnError(&#34;NOTIFICATION_SERVICE_DOWN&#34;, &#34;Notification service unavailable&#34;) else null" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>SequenceFlow_Reminder14Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Send14ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Reminder14Sent" name="14-day reminder sent">
      <bpmn:incoming>Flow_Send14ToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_Reminder14Skipped" name="14-day reminder skipped">
      <bpmn:incoming>SequenceFlow_Reminder14No</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_SendRmEscalation" name="Send RM escalation alert" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="bearer" target="authentication.type" />
          <zeebe:input source="headers" target="authentication.apiKeyLocation" />
          <zeebe:input target="authentication.name" />
          <zeebe:input target="authentication.value" />
          <zeebe:input target="authentication.username" />
          <zeebe:input target="authentication.password" />
          <zeebe:input source="{{secrets.NOTIFICATION_SERVICE_TOKEN}}" target="authentication.token" />
          <zeebe:input target="authentication.oauthTokenEndpoint" />
          <zeebe:input target="authentication.clientId" />
          <zeebe:input target="authentication.clientSecret" />
          <zeebe:input target="authentication.audience" />
          <zeebe:input target="authentication.clientAuthentication" />
          <zeebe:input target="authentication.scopes" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=notificationServiceBaseUrl + &#34;/notifications&#34;" target="url" />
          <zeebe:input target="headers" />
          <zeebe:input target="queryParameters" />
          <zeebe:input target="storeResponse" />
          <zeebe:input target="skipEncoding" />
          <zeebe:input target="followRedirects" />
          <zeebe:input target="connectionTimeoutInSeconds" />
          <zeebe:input target="readTimeoutInSeconds" />
          <zeebe:input source="={ template: &#34;RM_ESCALATION_ALERT&#34;, escalationType: &#34;NON_RESPONSIVE&#34;, caseId: caseId, recipient: relationshipManagerEmail, channel: &#34;internal&#34;, variables: { clientLegalName: clientLegalName, deadline: deadline, daysSinceRequest: 21 } }" target="body" />
          <zeebe:input target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="13" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={ notificationId: body.notificationId, deliveryStatus: body.deliveryStatus }" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Day21TimerOut</bpmn:incoming>
      <bpmn:outgoing>Flow_SendRmToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_RmEscalationSent" name="RM escalation sent">
      <bpmn:incoming>Flow_SendRmToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_PatchCaseEscalated" name="Patch case to escalated" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="bearer" target="authentication.type" />
          <zeebe:input source="headers" target="authentication.apiKeyLocation" />
          <zeebe:input target="authentication.name" />
          <zeebe:input target="authentication.value" />
          <zeebe:input target="authentication.username" />
          <zeebe:input target="authentication.password" />
          <zeebe:input source="{{secrets.CLIENTVAULT_TOKEN}}" target="authentication.token" />
          <zeebe:input target="authentication.oauthTokenEndpoint" />
          <zeebe:input target="authentication.clientId" />
          <zeebe:input target="authentication.clientSecret" />
          <zeebe:input target="authentication.audience" />
          <zeebe:input target="authentication.clientAuthentication" />
          <zeebe:input target="authentication.scopes" />
          <zeebe:input source="PATCH" target="method" />
          <zeebe:input source="=clientVaultBaseUrl + &#34;/cdd-cases/&#34; + caseId" target="url" />
          <zeebe:input target="headers" />
          <zeebe:input target="queryParameters" />
          <zeebe:input target="storeResponse" />
          <zeebe:input target="skipEncoding" />
          <zeebe:input target="followRedirects" />
          <zeebe:input target="connectionTimeoutInSeconds" />
          <zeebe:input target="readTimeoutInSeconds" />
          <zeebe:input source="={ status: &#34;ESCALATED&#34;, auditNote: { kind: &#34;SYSTEM&#34;, text: &#34;Case auto-escalated to ESCALATED at Day 35 - mandatory MLRO escalation&#34; } }" target="body" />
          <zeebe:input target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="13" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={ caseStatus: body.status, escalatedAt: body.updatedAt }" />
          <zeebe:header key="errorExpression" value="=if error.code = &#34;404&#34; then bpmnError(&#34;CASE_NOT_FOUND&#34;, &#34;CDD case not found in ClientVault&#34;) else null" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Day35TimerOut</bpmn:incoming>
      <bpmn:outgoing>Flow_PatchToSendMlro</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SendMlroEscalation" name="Send MLRO escalation" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="bearer" target="authentication.type" />
          <zeebe:input source="headers" target="authentication.apiKeyLocation" />
          <zeebe:input target="authentication.name" />
          <zeebe:input target="authentication.value" />
          <zeebe:input target="authentication.username" />
          <zeebe:input target="authentication.password" />
          <zeebe:input target="authentication.oauthTokenEndpoint" />
          <zeebe:input target="authentication.clientId" />
          <zeebe:input target="authentication.clientSecret" />
          <zeebe:input target="authentication.audience" />
          <zeebe:input target="authentication.clientAuthentication" />
          <zeebe:input target="authentication.scopes" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input target="headers" />
          <zeebe:input target="queryParameters" />
          <zeebe:input target="storeResponse" />
          <zeebe:input target="skipEncoding" />
          <zeebe:input target="followRedirects" />
          <zeebe:input target="connectionTimeoutInSeconds" />
          <zeebe:input target="readTimeoutInSeconds" />
          <zeebe:input source="={ template: &#34;MLRO_ESCALATION&#34;, escalationType: &#34;NON_RESPONSIVE_DAY35&#34;, caseId: caseId, clientLegalName: clientLegalName, deadline: deadline, escalationReason: &#34;Day-35 mandatory non-responsive escalation&#34; }" target="body" />
          <zeebe:input target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="13" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={ mlroEscalationId: body.escalationId, mlroChannel: body.channel }" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PatchToSendMlro</bpmn:incoming>
      <bpmn:outgoing>Flow_SendMlroToDecide</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_DecideMlroOutcome" name="Decide MLRO outcome">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-decide-mlro-outcome" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SendMlroToDecide</bpmn:incoming>
      <bpmn:outgoing>Flow_DecideToGateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_MlroOutcome" name="MLRO outcome?">
      <bpmn:incoming>Flow_DecideToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_MlroContinue</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_MlroOffboard</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_MlroExtend</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_DocumentsReceived" name="Documents received">
      <bpmn:incoming>Flow_WaitToDocsReceived</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_ContinueRefresh" name="Continue refresh">
      <bpmn:incoming>SequenceFlow_MlroContinue</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_ReferOffboarding" name="Refer to offboarding">
      <bpmn:incoming>SequenceFlow_MlroOffboard</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_ExtendDeadline" name="Extend deadline">
      <bpmn:incoming>SequenceFlow_MlroExtend</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_StartToWait" sourceRef="StartEvent_DocumentRequestIssued" targetRef="SubProcess_WaitForDocuments" />
    <bpmn:sequenceFlow id="Flow_WaitToDocsReceived" sourceRef="SubProcess_WaitForDocuments" targetRef="EndEvent_DocumentsReceived" />
    <bpmn:sequenceFlow id="Flow_Day7TimerOut" sourceRef="BoundaryEvent_Day7Timer" targetRef="Task_Send7DayReminder" />
    <bpmn:sequenceFlow id="Flow_Send7ToEnd" sourceRef="Task_Send7DayReminder" targetRef="EndEvent_Reminder7Sent" />
    <bpmn:sequenceFlow id="Flow_Day14TimerOut" sourceRef="BoundaryEvent_Day14Timer" targetRef="Task_DraftReminder14Body" />
    <bpmn:sequenceFlow id="Flow_DraftToApprove" sourceRef="Task_DraftReminder14Body" targetRef="Task_ApproveReminder14" />
    <bpmn:sequenceFlow id="Flow_ApproveToGateway" sourceRef="Task_ApproveReminder14" targetRef="Gateway_Reminder14Approved" />
    <bpmn:sequenceFlow id="SequenceFlow_Reminder14Yes" name="Approved" sourceRef="Gateway_Reminder14Approved" targetRef="Task_Send14DayReminder" />
    <bpmn:sequenceFlow id="SequenceFlow_Reminder14No" name="Cancelled" sourceRef="Gateway_Reminder14Approved" targetRef="EndEvent_Reminder14Skipped">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">=reminder14Approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Send14ToEnd" sourceRef="Task_Send14DayReminder" targetRef="EndEvent_Reminder14Sent" />
    <bpmn:sequenceFlow id="Flow_Day21TimerOut" sourceRef="BoundaryEvent_Day21Timer" targetRef="Task_SendRmEscalation" />
    <bpmn:sequenceFlow id="Flow_SendRmToEnd" sourceRef="Task_SendRmEscalation" targetRef="EndEvent_RmEscalationSent" />
    <bpmn:sequenceFlow id="Flow_Day35TimerOut" sourceRef="BoundaryEvent_Day35Timer" targetRef="Task_PatchCaseEscalated" />
    <bpmn:sequenceFlow id="Flow_PatchToSendMlro" sourceRef="Task_PatchCaseEscalated" targetRef="Task_SendMlroEscalation" />
    <bpmn:sequenceFlow id="Flow_SendMlroToDecide" sourceRef="Task_SendMlroEscalation" targetRef="Task_DecideMlroOutcome" />
    <bpmn:sequenceFlow id="Flow_DecideToGateway" sourceRef="Task_DecideMlroOutcome" targetRef="Gateway_MlroOutcome" />
    <bpmn:sequenceFlow id="SequenceFlow_MlroContinue" name="Continue refresh" sourceRef="Gateway_MlroOutcome" targetRef="EndEvent_ContinueRefresh">
      <bpmn:conditionExpression>=mlroOutcome = "CONTINUE_REFRESH"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_MlroOffboard" name="Refer offboarding" sourceRef="Gateway_MlroOutcome" targetRef="EndEvent_ReferOffboarding">
      <bpmn:conditionExpression>=mlroOutcome = "REFER_OFFBOARDING"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_MlroExtend" name="Extend deadline" sourceRef="Gateway_MlroOutcome" targetRef="EndEvent_ExtendDeadline">
      <bpmn:conditionExpression>=mlroOutcome = "EXTEND_DEADLINE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:textAnnotation id="TextAnnotation_StartTrigger">
      <bpmn:text>Triggered by: Phase 02 (Document request issued)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_ReceiveDocs">
      <bpmn:text>Implementation: Camunda message correlation by caseId; DocuSafe webhook subscriber + scheduled poll fallback against GET /cases/{caseId}/documents (allRequired &amp;&amp; expiredDocs==[] &amp;&amp; pendingReview==[])</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_Send7">
      <bpmn:text>Implementation: Notification Service POST /notifications template CDD_REMINDER_7DAY; conditional DocuSafe POST /cases/{caseId}/request-upload-link when link &gt; 48h; clientCommsFreeze gate; notificationBounced boundary attaches (edge-03)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_DraftAi">
      <bpmn:text>Implementation: AWS Bedrock (Claude Sonnet) renders CDD_REMINDER_14DAY body from clientLegalName, deadline, uploadLink; flags TCF-language anomalies; ≥0.90 auto-populate; 0.70-0.89 attach aiUncertaintyNote; &lt;0.70 fallback canonical template</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_Approve14">
      <bpmn:text>Manual: Hard constraint #5 — FCA TCF service-restriction language requires KYC analyst pre-approval; AI cannot hold approval authority. Group kyc-analysts; default assignee = case-owner. NEW timer boundary @ +7 days unclaimed escalates to KYC team-lead (Gap-6).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_Reminder14Gateway">
      <bpmn:text>Evaluates: reminder14Approved</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_Send14">
      <bpmn:text>Implementation: Notification Service POST /notifications template CDD_REMINDER_14DAY immediately after analyst approval (no intervening service task per hard constraint #5); upload-link refresh is part of send envelope; notificationBounced boundary attaches (edge-03)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_SendRm">
      <bpmn:text>Implementation: Notification Service POST /notifications template RM_ESCALATION_ALERT escalationType=NON_RESPONSIVE; internal channel; clientCommsFreeze does NOT apply; case stays PENDING_DOCUMENTS; edge-03 excluded</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_PatchEscalated">
      <bpmn:text>Implementation: ClientVault PATCH /cdd-cases/{caseId} body { status: ESCALATED } — auditable transition logged as SYSTEM note (hard constraint #12, 5-year retention)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_SendMlro">
      <bpmn:text>Implementation: Compliance/MLRO escalation channel — ❓ Gap-2 unresolved: concrete channel TBD (dedicated MLRO Notification Service template OR internal email OR ServiceNow connector). Parameterised ServiceTask pending reviewer answer.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_DecideMlro">
      <bpmn:text>Manual: Hard constraint #3 — MLRO statutory AML judgement (MLR 2017 / SYSC 6.3) non-delegable; deputy permitted per JMLSG §3.19 ≤12 weeks rolling. NEW SLA timer (non-interrupting) escalates if unclaimed; ❓ Gap-3: SLA duration TBD (placeholder 5 business days).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_MlroGateway">
      <bpmn:text>Evaluates: mlroOutcome</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_DocsReceivedFollowup">
      <bpmn:text>Follow-up: Phase 04 (Document review &amp; sign-off)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_OffboardFollowup">
      <bpmn:text>Follow-up: Phase 09 closure with outcome OFFBOARDING_REFERRED</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_ContinueFollowup">
      <bpmn:text>Follow-up: Re-enter wait state with new notificationSentAt anchor (per MLRO direction) OR route to Phase 02 to reissue document request</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_ExtendFollowup">
      <bpmn:text>Follow-up: Reset notificationSentAt = mlroDecisionAt and re-enter wait state</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_StartTrigger" associationDirection="None" sourceRef="StartEvent_DocumentRequestIssued" targetRef="TextAnnotation_StartTrigger" />
