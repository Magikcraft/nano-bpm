<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_Process06SanctionsGate" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.46.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="Process06SanctionsGateProcess" name="Phase 06 - Sanctions hit gateway and MLRO escalation" isExecutable="true">
    <bpmn:startEvent id="StartEvent_PhaseEntered" name="Sanctions gate entered">
      <bpmn:outgoing>Flow_StartToG1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_AnySanctionsHit" name="Any sanctions hit?" default="SequenceFlow_NoSanctionsHit">
      <bpmn:incoming>Flow_StartToG1</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_NoSanctionsHit</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_SanctionsHit</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="ParallelGateway_Split_1" name="">
      <bpmn:incoming>SequenceFlow_SanctionsHit</bpmn:incoming>
      <bpmn:outgoing>Flow_Split1ToT2</bpmn:outgoing>
      <bpmn:outgoing>Flow_Split1ToT3</bpmn:outgoing>
      <bpmn:outgoing>Flow_Split1ToT4</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_SetClientCommsFreeze" name="Set client comms freeze">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="set-client-comms-freeze" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Split1ToT2</bpmn:incoming>
      <bpmn:outgoing>Flow_T2ToJoin1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_PatchCaseEscalated" name="Escalate case in ClientVault" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="headers" target="authentication.apiKeyLocation" />
          <zeebe:input source="=&#34;X-API-Key&#34;" target="authentication.name" />
          <zeebe:input source="{{secrets.CLIENTVAULT_API_KEY}}" target="authentication.value" />
          <zeebe:input target="authentication.username" />
          <zeebe:input target="authentication.password" />
          <zeebe:input target="authentication.token" />
          <zeebe:input target="authentication.oauthTokenEndpoint" />
          <zeebe:input target="authentication.clientId" />
          <zeebe:input target="authentication.clientSecret" />
          <zeebe:input target="authentication.audience" />
          <zeebe:input target="authentication.clientAuthentication" />
          <zeebe:input target="authentication.scopes" />
          <zeebe:input source="PATCH" target="method" />
          <zeebe:input source="=&#34;https://api.clientvault.local/cdd-cases/&#34; + caseId" target="url" />
          <zeebe:input target="headers" />
          <zeebe:input target="queryParameters" />
          <zeebe:input target="storeResponse" />
          <zeebe:input target="skipEncoding" />
          <zeebe:input target="followRedirects" />
          <zeebe:input target="connectionTimeoutInSeconds" />
          <zeebe:input target="readTimeoutInSeconds" />
          <zeebe:input source="={ status: &#34;ESCALATED&#34; }" target="body" />
          <zeebe:input target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="13" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="errorExpression" value="=if response.status = 404 then bpmnError(&#34;CASE_NOT_FOUND&#34;, &#34;Case not found in ClientVault&#34;) else null" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Split1ToT3</bpmn:incoming>
      <bpmn:outgoing>Flow_T3ToJoin1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SendRmEscalationAlert" name="Send RM escalation alert" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="headers" target="authentication.apiKeyLocation" />
          <zeebe:input source="=&#34;X-API-Key&#34;" target="authentication.name" />
          <zeebe:input source="{{secrets.NOTIFICATION_API_KEY}}" target="authentication.value" />
          <zeebe:input target="authentication.username" />
          <zeebe:input target="authentication.password" />
          <zeebe:input target="authentication.token" />
          <zeebe:input target="authentication.oauthTokenEndpoint" />
          <zeebe:input target="authentication.clientId" />
          <zeebe:input target="authentication.clientSecret" />
          <zeebe:input target="authentication.audience" />
          <zeebe:input target="authentication.clientAuthentication" />
          <zeebe:input target="authentication.scopes" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=&#34;https://api.notification.local/notifications&#34;" target="url" />
          <zeebe:input target="headers" />
          <zeebe:input target="queryParameters" />
          <zeebe:input target="storeResponse" />
          <zeebe:input target="skipEncoding" />
          <zeebe:input target="followRedirects" />
          <zeebe:input target="connectionTimeoutInSeconds" />
          <zeebe:input target="readTimeoutInSeconds" />
          <zeebe:input source="={ template: &#34;RM_ESCALATION_ALERT&#34;, caseId: caseId, recipient: rmUsername, templateVars: { escalationType: &#34;SANCTIONS&#34; }, bypassCommsFreeze: true }" target="body" />
          <zeebe:input target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="13" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={ rmEscalationNotificationId: body.notificationId, rmEscalationDeliveryStatus: body.deliveryStatus }" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Split1ToT4</bpmn:incoming>
      <bpmn:outgoing>Flow_T4ToJoin1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ParallelGateway_Join_1" name="">
      <bpmn:incoming>Flow_T2ToJoin1</bpmn:incoming>
      <bpmn:incoming>Flow_T3ToJoin1</bpmn:incoming>
      <bpmn:incoming>Flow_T4ToJoin1</bpmn:incoming>
      <bpmn:outgoing>Flow_Join1ToT5</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Task_MlroSanctionsDecision" name="Decide MLRO sanctions outcome">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-mlro-sanctions-decision" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Join1ToT5</bpmn:incoming>
      <bpmn:outgoing>Flow_T5ToG2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="BoundaryEvent_MlroAlertSla" name="1h SLA elapsed" cancelActivity="false" attachedToRef="Task_MlroSanctionsDecision">
      <bpmn:outgoing>Flow_BoundarySlaToAlert</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_MlroAlertSla">
        <bpmn:timeDuration>PT1H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:boundaryEvent id="BoundaryEvent_MlroSlaCycle" name="Hourly SLA reminder" cancelActivity="false" attachedToRef="Task_MlroSanctionsDecision">
      <bpmn:outgoing>Flow_BoundaryCycleToReminder</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_MlroSlaCycle">
        <bpmn:timeCycle>R/PT1H</bpmn:timeCycle>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:serviceTask id="Task_AlertDeputyMlro" name="Alert deputy MLRO" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="headers" target="authentication.apiKeyLocation" />
          <zeebe:input source="=&#34;X-API-Key&#34;" target="authentication.name" />
          <zeebe:input source="{{secrets.NOTIFICATION_API_KEY}}" target="authentication.value" />
          <zeebe:input target="authentication.username" />
          <zeebe:input target="authentication.password" />
          <zeebe:input target="authentication.token" />
          <zeebe:input target="authentication.oauthTokenEndpoint" />
          <zeebe:input target="authentication.clientId" />
          <zeebe:input target="authentication.clientSecret" />
          <zeebe:input target="authentication.audience" />
          <zeebe:input target="authentication.clientAuthentication" />
          <zeebe:input target="authentication.scopes" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=&#34;https://api.notification.local/notifications&#34;" target="url" />
          <zeebe:input target="headers" />
          <zeebe:input target="queryParameters" />
          <zeebe:input target="storeResponse" />
          <zeebe:input target="skipEncoding" />
          <zeebe:input target="followRedirects" />
          <zeebe:input target="connectionTimeoutInSeconds" />
          <zeebe:input target="readTimeoutInSeconds" />
          <zeebe:input source="={ template: &#34;RM_ESCALATION_ALERT&#34;, caseId: caseId, recipient: &#34;deputy-mlro&#34;, templateVars: { escalationTier: 1, escalationType: &#34;SANCTIONS_SLA&#34; } }" target="body" />
          <zeebe:input target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="13" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={ deputyMlroAlertNotificationId: body.notificationId }" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_BoundarySlaToAlert</bpmn:incoming>
      <bpmn:outgoing>Flow_AlertDeputyMlroToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_SendSlaReminder" name="Send SLA breach reminder" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="headers" target="authentication.apiKeyLocation" />
          <zeebe:input source="=&#34;X-API-Key&#34;" target="authentication.name" />
          <zeebe:input source="{{secrets.NOTIFICATION_API_KEY}}" target="authentication.value" />
          <zeebe:input target="authentication.username" />
          <zeebe:input target="authentication.password" />
          <zeebe:input target="authentication.token" />
          <zeebe:input target="authentication.oauthTokenEndpoint" />
          <zeebe:input target="authentication.clientId" />
          <zeebe:input target="authentication.clientSecret" />
          <zeebe:input target="authentication.audience" />
          <zeebe:input target="authentication.clientAuthentication" />
          <zeebe:input target="authentication.scopes" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=&#34;https://api.notification.local/notifications&#34;" target="url" />
          <zeebe:input target="headers" />
          <zeebe:input target="queryParameters" />
          <zeebe:input target="storeResponse" />
          <zeebe:input target="skipEncoding" />
          <zeebe:input target="followRedirects" />
          <zeebe:input target="connectionTimeoutInSeconds" />
          <zeebe:input target="readTimeoutInSeconds" />
          <zeebe:input source="={ template: &#34;RM_ESCALATION_ALERT&#34;, caseId: caseId, recipients: [&#34;mlro&#34;, &#34;deputy-mlro&#34;, &#34;head-of-compliance&#34;], templateVars: { escalationType: &#34;SANCTIONS_SLA_BREACH&#34; } }" target="body" />
          <zeebe:input target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="13" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={ slaReminderNotificationId: body.notificationId }" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_BoundaryCycleToReminder</bpmn:incoming>
      <bpmn:outgoing>Flow_SlaReminderToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_DeputyAlerted" name="Deputy MLRO alerted">
      <bpmn:incoming>Flow_AlertDeputyMlroToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_SlaReminderSent" name="SLA reminder sent">
      <bpmn:incoming>Flow_SlaReminderToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_MlroDetermination" name="MLRO determination?" default="SequenceFlow_FalsePositiveDismiss">
      <bpmn:incoming>Flow_T5ToG2</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_FalsePositiveDismiss</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ConfirmedProceedWithEdd</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_Offboard</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_FreezeIndefinitely</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_EscalateToNcaSar</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:parallelGateway id="ParallelGateway_Split_2" name="">
      <bpmn:incoming>SequenceFlow_FalsePositiveDismiss</bpmn:incoming>
      <bpmn:outgoing>Flow_Split2ToT6</bpmn:outgoing>
      <bpmn:outgoing>Flow_Split2ToT7</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_DismissScreeningHit" name="Dismiss screening hit" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="headers" target="authentication.apiKeyLocation" />
          <zeebe:input source="=&#34;X-API-Key&#34;" target="authentication.name" />
          <zeebe:input source="{{secrets.SANCTIONGUARD_API_KEY}}" target="authentication.value" />
          <zeebe:input target="authentication.username" />
          <zeebe:input target="authentication.password" />
          <zeebe:input target="authentication.token" />
          <zeebe:input target="authentication.oauthTokenEndpoint" />
          <zeebe:input target="authentication.clientId" />
          <zeebe:input target="authentication.clientSecret" />
          <zeebe:input target="authentication.audience" />
          <zeebe:input target="authentication.clientAuthentication" />
          <zeebe:input target="authentication.scopes" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=&#34;https://api.sanctionguard.local/screens/&#34; + screeningId + &#34;/dismiss&#34;" target="url" />
          <zeebe:input target="headers" />
          <zeebe:input target="queryParameters" />
          <zeebe:input target="storeResponse" />
          <zeebe:input target="skipEncoding" />
          <zeebe:input target="followRedirects" />
          <zeebe:input target="connectionTimeoutInSeconds" />
          <zeebe:input target="readTimeoutInSeconds" />
          <zeebe:input source="={ dismissalReason: dismissalReason, analystUsername: analystUsername }" target="body" />
          <zeebe:input target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="13" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="errorExpression" value="=if response.status = 404 then bpmnError(&#34;SCREENING_NOT_FOUND&#34;, &#34;Screening record not found in SanctionGuard&#34;) else if response.status = 422 then bpmnError(&#34;DISMISSAL_REASON_TOO_SHORT&#34;, &#34;Dismissal reason fails server-side validation&#34;) else null" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Split2ToT6</bpmn:incoming>
      <bpmn:outgoing>Flow_T6ToJoin2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_LiftCommsFreeze" name="Lift client comms freeze">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="lift-client-comms-freeze" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Split2ToT7</bpmn:incoming>
      <bpmn:outgoing>Flow_T7ToJoin2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ParallelGateway_Join_2" name="">
      <bpmn:incoming>Flow_T6ToJoin2</bpmn:incoming>
      <bpmn:incoming>Flow_T7ToJoin2</bpmn:incoming>
      <bpmn:outgoing>Flow_Join2ToT7b</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_LogDismissAuditNote" name="Log dismiss audit note" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="headers" target="authentication.apiKeyLocation" />
          <zeebe:input source="=&#34;X-API-Key&#34;" target="authentication.name" />
          <zeebe:input source="{{secrets.CLIENTVAULT_API_KEY}}" target="authentication.value" />
          <zeebe:input target="authentication.username" />
          <zeebe:input target="authentication.password" />
          <zeebe:input target="authentication.token" />
          <zeebe:input target="authentication.oauthTokenEndpoint" />
          <zeebe:input target="authentication.clientId" />
          <zeebe:input target="authentication.clientSecret" />
          <zeebe:input target="authentication.audience" />
          <zeebe:input target="authentication.clientAuthentication" />
          <zeebe:input target="authentication.scopes" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=&#34;https://api.clientvault.local/cdd-cases/&#34; + caseId + &#34;/notes&#34;" target="url" />
          <zeebe:input target="headers" />
          <zeebe:input target="queryParameters" />
          <zeebe:input target="storeResponse" />
          <zeebe:input target="skipEncoding" />
          <zeebe:input target="followRedirects" />
          <zeebe:input target="connectionTimeoutInSeconds" />
          <zeebe:input target="readTimeoutInSeconds" />
          <zeebe:input source="={ type: &#34;SYSTEM&#34;, event: &#34;MLRO_FALSE_POSITIVE_DISMISS&#34;, screeningId: screeningId, mlroUserId: mlroUserId, dismissalReason: dismissalReason, analystUsername: analystUsername, timestamp: now() }" target="body" />
          <zeebe:input target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="13" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={ dismissAuditNoteId: body.noteId }" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Join2ToT7b</bpmn:incoming>
      <bpmn:outgoing>Flow_T7bToMerge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_MergeToPhase07" name="">
      <bpmn:incoming>SequenceFlow_NoSanctionsHit</bpmn:incoming>
      <bpmn:incoming>Flow_T7bToMerge</bpmn:incoming>
      <bpmn:outgoing>Flow_MergeToPhase07End</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_SetEddRequired" name="Set EDD required">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="set-edd-required" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>SequenceFlow_ConfirmedProceedWithEdd</bpmn:incoming>
      <bpmn:outgoing>Flow_T8ToEnd</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_ContinueToPhase07" name="Continued to Phase 07">
      <bpmn:incoming>Flow_MergeToPhase07End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_EddRequired" name="EDD required">
      <bpmn:incoming>Flow_T8ToEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_OffboardingReferred" name="MLRO escalation - offboarding referred">
      <bpmn:incoming>SequenceFlow_Offboard</bpmn:incoming>
      <bpmn:terminateEventDefinition id="TerminateEventDefinition_Offboard" />
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_CaseFrozen" name="MLRO escalation - case frozen">
      <bpmn:incoming>SequenceFlow_FreezeIndefinitely</bpmn:incoming>
      <bpmn:terminateEventDefinition id="TerminateEventDefinition_Freeze" />
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_ReferredToNca" name="Referred to NCA">
      <bpmn:incoming>SequenceFlow_EscalateToNcaSar</bpmn:incoming>
      <bpmn:terminateEventDefinition id="TerminateEventDefinition_NcaSar" />
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_StartToG1" sourceRef="StartEvent_PhaseEntered" targetRef="Gateway_AnySanctionsHit" />
    <bpmn:sequenceFlow id="SequenceFlow_NoSanctionsHit" name="No" sourceRef="Gateway_AnySanctionsHit" targetRef="Gateway_MergeToPhase07" />
    <bpmn:sequenceFlow id="SequenceFlow_SanctionsHit" name="Yes" sourceRef="Gateway_AnySanctionsHit" targetRef="ParallelGateway_Split_1">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">=some h in hits satisfies h.category = "SANCTIONS" and (h.status = "POTENTIAL_MATCH" or h.status = "CONFIRMED_MATCH")</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Split1ToT2" sourceRef="ParallelGateway_Split_1" targetRef="Task_SetClientCommsFreeze" />
    <bpmn:sequenceFlow id="Flow_Split1ToT3" sourceRef="ParallelGateway_Split_1" targetRef="Task_PatchCaseEscalated" />
    <bpmn:sequenceFlow id="Flow_Split1ToT4" sourceRef="ParallelGateway_Split_1" targetRef="Task_SendRmEscalationAlert" />
    <bpmn:sequenceFlow id="Flow_T2ToJoin1" sourceRef="Task_SetClientCommsFreeze" targetRef="ParallelGateway_Join_1" />
    <bpmn:sequenceFlow id="Flow_T3ToJoin1" sourceRef="Task_PatchCaseEscalated" targetRef="ParallelGateway_Join_1" />
    <bpmn:sequenceFlow id="Flow_T4ToJoin1" sourceRef="Task_SendRmEscalationAlert" targetRef="ParallelGateway_Join_1" />
    <bpmn:sequenceFlow id="Flow_Join1ToT5" sourceRef="ParallelGateway_Join_1" targetRef="Task_MlroSanctionsDecision" />
    <bpmn:sequenceFlow id="Flow_T5ToG2" sourceRef="Task_MlroSanctionsDecision" targetRef="Gateway_MlroDetermination" />
    <bpmn:sequenceFlow id="Flow_BoundarySlaToAlert" sourceRef="BoundaryEvent_MlroAlertSla" targetRef="Task_AlertDeputyMlro" />
    <bpmn:sequenceFlow id="Flow_AlertDeputyMlroToEnd" sourceRef="Task_AlertDeputyMlro" targetRef="EndEvent_DeputyAlerted" />
    <bpmn:sequenceFlow id="Flow_BoundaryCycleToReminder" sourceRef="BoundaryEvent_MlroSlaCycle" targetRef="Task_SendSlaReminder" />
    <bpmn:sequenceFlow id="Flow_SlaReminderToEnd" sourceRef="Task_SendSlaReminder" targetRef="EndEvent_SlaReminderSent" />
    <bpmn:sequenceFlow id="SequenceFlow_FalsePositiveDismiss" name="False positive - dismiss" sourceRef="Gateway_MlroDetermination" targetRef="ParallelGateway_Split_2" />
    <bpmn:sequenceFlow id="SequenceFlow_ConfirmedProceedWithEdd" name="Confirmed - proceed with EDD" sourceRef="Gateway_MlroDetermination" targetRef="Task_SetEddRequired">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">=mlroDetermination = "confirmed_proceed_with_edd"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_Offboard" name="Offboard" sourceRef="Gateway_MlroDetermination" targetRef="EndEvent_OffboardingReferred">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">=mlroDetermination = "offboard"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_FreezeIndefinitely" name="Freeze indefinitely" sourceRef="Gateway_MlroDetermination" targetRef="EndEvent_CaseFrozen">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">=mlroDetermination = "freeze_indefinitely"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_EscalateToNcaSar" name="Escalate to NCA SAR" sourceRef="Gateway_MlroDetermination" targetRef="EndEvent_ReferredToNca">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">=mlroDetermination = "escalate_to_NCA_SAR"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Split2ToT6" sourceRef="ParallelGateway_Split_2" targetRef="Task_DismissScreeningHit" />
    <bpmn:sequenceFlow id="Flow_Split2ToT7" sourceRef="ParallelGateway_Split_2" targetRef="Task_LiftCommsFreeze" />
    <bpmn:sequenceFlow id="Flow_T6ToJoin2" sourceRef="Task_DismissScreeningHit" targetRef="ParallelGateway_Join_2" />
    <bpmn:sequenceFlow id="Flow_T7ToJoin2" sourceRef="Task_LiftCommsFreeze" targetRef="ParallelGateway_Join_2" />
    <bpmn:sequenceFlow id="Flow_Join2ToT7b" sourceRef="ParallelGateway_Join_2" targetRef="Task_LogDismissAuditNote" />
    <bpmn:sequenceFlow id="Flow_T7bToMerge" sourceRef="Task_LogDismissAuditNote" targetRef="Gateway_MergeToPhase07" />
    <bpmn:sequenceFlow id="Flow_MergeToPhase07End" sourceRef="Gateway_MergeToPhase07" targetRef="EndEvent_ContinueToPhase07" />
    <bpmn:sequenceFlow id="Flow_T8ToEnd" sourceRef="Task_SetEddRequired" targetRef="EndEvent_EddRequired" />
    <bpmn:textAnnotation id="TextAnnotation_StartEvent">
      <bpmn:text>Triggered by: upstream Phase 05 (parallel screening) handing off after SanctionGuard returns hits</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_G1">
      <bpmn:text>Evaluates: hits[*] where category == SANCTIONS and status in {POTENTIAL_MATCH, CONFIRMED_MATCH}</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_T2">
      <bpmn:text>Implementation: Camunda engine IO mapping - sets process variable clientCommsFreeze = true on sanctions-hit branch. No external API.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_T3">
      <bpmn:text>Implementation: ClientVault PATCH /cdd-cases/{caseId} with body {"status": "ESCALATED"}; X-API-Key auth via secrets.CLIENTVAULT_API_KEY. Error boundary CASE_NOT_FOUND (404) -&gt; technical incident; default Camunda retry on 5xx.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_T4">
      <bpmn:text>Implementation: Notification Service POST /notifications with template RM_ESCALATION_ALERT, templateVars { escalationType: "SANCTIONS" }; exempt from clientCommsFreeze. Auto-logs COMMUNICATION case note in ClientVault.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_T5">
      <bpmn:text>Implementation: Camunda Tasklist form; assignee = mlro group (or deputy-mlro during cover up to 12 weeks per JMLSG 3.19). Output mlroDetermination in {false_positive_dismiss, confirmed_proceed_with_edd, offboard, freeze_indefinitely, escalate_to_NCA_SAR}; minimum 20-char dismissalReason and analystUsername mandatory when false_positive_dismiss.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_T5_Manual">
      <bpmn:text>Manual: MLRO sanctions decision is non-delegable per MLR 2017 / JMLSG 3.19; AI may not make sanctions or risk-tier decisions (hard constraint #1).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_AlertDeputy">
      <bpmn:text>Implementation: Notification Service POST /notifications with template RM_ESCALATION_ALERT, escalation tier = 1; reassigns task to deputy-mlro group via assignment listener. Non-interrupting - UserTask remains active.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_SlaReminder">
      <bpmn:text>Implementation: Notification Service POST /notifications with template RM_ESCALATION_ALERT and tiered CC list (MLRO, Deputy MLRO, Head of Compliance); each call emits its own ClientVault COMMUNICATION audit note. Repeats hourly until UserTask completes (FCA Q4 2024 finding on missing sanctions records).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_G2">
      <bpmn:text>Evaluates: mlroDetermination</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_T6">
      <bpmn:text>Implementation: SanctionGuard POST /screens/{screeningId}/dismiss with { dismissalReason, analystUsername }; X-API-Key auth. Error boundary SCREENING_NOT_FOUND (404) -&gt; manual investigation; DISMISSAL_REASON_TOO_SHORT (422) preempted by T5 form validation.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_T7">
      <bpmn:text>Implementation: Camunda engine IO mapping - sets process variable clientCommsFreeze = false. No external API.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_T7b">
      <bpmn:text>Implementation: ClientVault POST /cdd-cases/{caseId}/notes with type SYSTEM and body { event: "MLRO_FALSE_POSITIVE_DISMISS", screeningId, mlroUserId, dismissalReason, analystUsername, timestamp }. Durable audit anchor for 5-year MLR 2017 reg. 40 retention horizon.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_T8">
      <bpmn:text>Implementation: Camunda engine IO mapping - sets process variable eddRequired = true; clientCommsFreeze stays true (only lifted on written MLRO clearance in Phase 08). Drives DMN routing into Phase 08 EDD branch.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_EndContinue">
      <bpmn:text>Follow-up: re-enters main flow at Phase 07 (risk assessment) with clientCommsFreeze updated per branch.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_EndEdd">
      <bpmn:text>Follow-up: Phase 08 EDD/MLRO branch picks up case; clientCommsFreeze stays true until written MLRO clearance.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_EndOffboard">
      <bpmn:text>Follow-up: out-of-band MLRO offboarding workflow; case stays ESCALATED in ClientVault. No /close write at this terminal (hard constraint #9).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_EndFrozen">
      <bpmn:text>Follow-up: out-of-band MLRO disposition; case stays ESCALATED indefinitely. No /close write (hard constraint #9).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_EndNca">
      <bpmn:text>Follow-up: NCA SAR submission performed manually out-of-band (v1 scope gap; no NCA-Theme integration). Case stays ESCALATED in ClientVault.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_EndDeputyAlerted">
      <bpmn:text>Follow-up: deputy MLRO now seeing the live task; original 1h SLA event recorded in audit log.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_EndSlaReminderSent">
      <bpmn:text>Follow-up: incremented escalation tier counter; subsequent reminders escalate CC list (MLRO, Deputy MLRO, Head of Compliance).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_StartEvent" associationDirection="None" sourceRef="StartEvent_PhaseEntered" targetRef="TextAnnotation_StartEvent" />
    <bpmn:association id="Association_G1" associationDirection="None" sourceRef="Gateway_AnySanctionsHit" targetRef="TextAnnotation_G1" />
