<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.46.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:process id="Process08ApprovalProcess" name="Phase 8: Tiered Approval (with EDD/MLRO Branch)" isExecutable="true">
    <bpmn:startEvent id="StartEvent_ApprovalRequested" name="Approval requested">
      <bpmn:outgoing>Flow_StartToGateway</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:exclusiveGateway id="Gateway_ApprovalRouting" name="Which approval branch?" default="SequenceFlow_ToElevatedBranch">
      <bpmn:incoming>Flow_StartToGateway</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ToAnalystBranch</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ToElevatedBranch</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ToHighBranch</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ToMlroBranch</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_PeerAnalystReview" name="Conduct peer analyst review">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-peer-analyst-review" />
      </bpmn:extensionElements>
      <bpmn:incoming>SequenceFlow_ToAnalystBranch</bpmn:incoming>
      <bpmn:outgoing>Flow_PeerReviewToSubmit</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_SubmitAnalystApproval" name="Submit analyst approval" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="headers" target="authentication.apiKeyLocation" />
          <zeebe:input target="authentication.name" />
          <zeebe:input target="authentication.value" />
          <zeebe:input target="authentication.username" />
          <zeebe:input target="authentication.password" />
          <zeebe:input target="authentication.token" />
          <zeebe:input target="authentication.oauthTokenEndpoint" />
          <zeebe:input target="authentication.clientId" />
          <zeebe:input target="authentication.clientSecret" />
          <zeebe:input target="authentication.audience" />
          <zeebe:input target="authentication.clientAuthentication" />
          <zeebe:input target="authentication.scopes" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=&#34;https://clientvault.meridian.local/cdd-cases/&#34; + caseId + &#34;/submit-for-approval&#34;" target="url" />
          <zeebe:input target="headers" />
          <zeebe:input target="queryParameters" />
          <zeebe:input target="storeResponse" />
          <zeebe:input target="skipEncoding" />
          <zeebe:input target="followRedirects" />
          <zeebe:input source="20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="20" target="readTimeoutInSeconds" />
          <zeebe:input source="={ approvalLevel: &#34;ANALYST&#34;, approverUsername: peerReviewerUsername, approvalDate: peerReviewDate }" target="body" />
          <zeebe:input target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="13" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={ analystSubmitStatus: body.status, analystSubmitTimestamp: body.timestamp }" />
          <zeebe:header key="errorExpression" value="=if response.statusCode &#62;= 400 then bpmnError(&#34;SUBMIT_APPROVAL_FAILED&#34;, &#34;ClientVault submit-for-approval failed&#34;) else null" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PeerReviewToSubmit</bpmn:incoming>
      <bpmn:outgoing>Flow_AnalystSubmitToOutcome</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_SeniorManagerReview" name="Conduct senior manager review">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-senior-manager-review" />
      </bpmn:extensionElements>
      <bpmn:incoming>SequenceFlow_ToElevatedBranch</bpmn:incoming>
      <bpmn:outgoing>Flow_SeniorReviewToSubmit</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_SubmitSeniorApproval" name="Submit senior manager approval" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="headers" target="authentication.apiKeyLocation" />
          <zeebe:input target="authentication.name" />
          <zeebe:input target="authentication.value" />
          <zeebe:input target="authentication.username" />
          <zeebe:input target="authentication.password" />
          <zeebe:input target="authentication.token" />
          <zeebe:input target="authentication.oauthTokenEndpoint" />
          <zeebe:input target="authentication.clientId" />
          <zeebe:input target="authentication.clientSecret" />
          <zeebe:input target="authentication.audience" />
          <zeebe:input target="authentication.clientAuthentication" />
          <zeebe:input target="authentication.scopes" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=&#34;https://clientvault.meridian.local/cdd-cases/&#34; + caseId + &#34;/submit-for-approval&#34;" target="url" />
          <zeebe:input target="headers" />
          <zeebe:input target="queryParameters" />
          <zeebe:input target="storeResponse" />
          <zeebe:input target="skipEncoding" />
          <zeebe:input target="followRedirects" />
          <zeebe:input source="20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="20" target="readTimeoutInSeconds" />
          <zeebe:input source="={ approvalLevel: &#34;SENIOR_MANAGER&#34;, approverUsername: approverUsername, approvalDate: approvalDate }" target="body" />
          <zeebe:input target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="13" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={ seniorSubmitStatus: body.status, seniorSubmitTimestamp: body.timestamp }" />
          <zeebe:header key="errorExpression" value="=if response.statusCode &#62;= 400 then bpmnError(&#34;SUBMIT_APPROVAL_FAILED&#34;, &#34;ClientVault submit-for-approval failed&#34;) else null" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_SeniorReviewToSubmit</bpmn:incoming>
      <bpmn:outgoing>Flow_SeniorSubmitToOutcome</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:parallelGateway id="ParallelGateway_HighSplit" name="">
      <bpmn:incoming>SequenceFlow_ToHighBranch</bpmn:incoming>
      <bpmn:outgoing>Flow_HighSplitToSenior</bpmn:outgoing>
      <bpmn:outgoing>Flow_HighSplitToCompliance</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:userTask id="Task_HighSeniorManagerReview" name="Conduct senior manager co-sign review">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-high-senior-manager-review" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_HighSplitToSenior</bpmn:incoming>
      <bpmn:outgoing>Flow_HighSeniorToJoin</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_HighComplianceReview" name="Conduct compliance officer co-sign review">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-high-compliance-review" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_HighSplitToCompliance</bpmn:incoming>
      <bpmn:outgoing>Flow_HighComplianceToJoin</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:parallelGateway id="ParallelGateway_HighJoin" name="">
      <bpmn:incoming>Flow_HighSeniorToJoin</bpmn:incoming>
      <bpmn:incoming>Flow_HighComplianceToJoin</bpmn:incoming>
      <bpmn:outgoing>Flow_HighJoinToSubmit</bpmn:outgoing>
    </bpmn:parallelGateway>
    <bpmn:serviceTask id="Task_SubmitHighApprovalAndNote" name="Submit high-tier approval and audit note" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="headers" target="authentication.apiKeyLocation" />
          <zeebe:input target="authentication.name" />
          <zeebe:input target="authentication.value" />
          <zeebe:input target="authentication.username" />
          <zeebe:input target="authentication.password" />
          <zeebe:input target="authentication.token" />
          <zeebe:input target="authentication.oauthTokenEndpoint" />
          <zeebe:input target="authentication.clientId" />
          <zeebe:input target="authentication.clientSecret" />
          <zeebe:input target="authentication.audience" />
          <zeebe:input target="authentication.clientAuthentication" />
          <zeebe:input target="authentication.scopes" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=&#34;https://clientvault.meridian.local/cdd-cases/&#34; + caseId + &#34;/submit-for-approval&#34;" target="url" />
          <zeebe:input target="headers" />
          <zeebe:input target="queryParameters" />
          <zeebe:input target="storeResponse" />
          <zeebe:input target="skipEncoding" />
          <zeebe:input target="followRedirects" />
          <zeebe:input source="20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="20" target="readTimeoutInSeconds" />
          <zeebe:input source="={ approvalLevel: &#34;SENIOR_MANAGER&#34;, approverUsername: complianceApproverUsername, approvalDate: complianceApprovalDate, coApprovers: [{ username: seniorApproverUsername, approvalDate: seniorApprovalDate }, { username: complianceApproverUsername, approvalDate: complianceApprovalDate }], dualCosignRationale: &#34;HIGH-tier dual co-sign per Hard Constraint #10&#34; }" target="body" />
          <zeebe:input target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="13" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={ highSubmitStatus: body.status, highSubmitTimestamp: body.timestamp }" />
          <zeebe:header key="errorExpression" value="=if response.statusCode &#62;= 400 then bpmnError(&#34;SUBMIT_APPROVAL_FAILED&#34;, &#34;ClientVault submit-for-approval failed&#34;) else null" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_HighJoinToSubmit</bpmn:incoming>
      <bpmn:outgoing>Flow_HighSubmitToOutcome</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:subProcess id="SubProcess_EddInvestigation" name="Conduct EDD investigation">
      <bpmn:incoming>SequenceFlow_ToMlroBranch</bpmn:incoming>
      <bpmn:outgoing>Flow_EddToMlroSignOff</bpmn:outgoing>
      <bpmn:startEvent id="StartEvent_EddStart" name="EDD investigation started">
        <bpmn:outgoing>Flow_EddStartToAi</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:serviceTask id="Task_DraftEddWithAi" name="Draft EDD investigation with AI" zeebe:modelerTemplate="io.camunda.connectors.aws.bedrock.v1" zeebe:modelerTemplateVersion="3" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:aws-bedrock:1" />
          <zeebe:ioMapping>
            <zeebe:input source="credentials" target="authentication.type" />
            <zeebe:input source="{{secrets.AWS_ACCESS_KEY}}" target="authentication.accessKey" />
            <zeebe:input source="{{secrets.AWS_SECRET_KEY}}" target="authentication.secretKey" />
            <zeebe:input source="{{secrets.AWS_REGION}}" target="configuration.region" />
            <zeebe:input target="configuration.endpoint" />
            <zeebe:input source="invokeModel" target="action" />
            <zeebe:input source="=&#34;anthropic.claude-3-5-sonnet-20241022-v2:0&#34;" target="data.modelId" />
            <zeebe:input source="={ messages: [{ role: &#34;user&#34;, content: &#34;Draft an Enhanced Due Diligence investigation report for case &#34; + caseId + &#34; (&#34; + clientLegalName + &#34;), risk tier &#34; + newRiskTier + &#34;. Include source-of-wealth analysis, PEP/sanctions context, jurisdictional risk, and recommended corroboration sources.&#34; }] }" target="data.payload" />
            <zeebe:input target="data.messagesHistory" />
            <zeebe:input target="data.modelId" />
            <zeebe:input target="data.newMessage" />
            <zeebe:input source="=4096" target="data.maxTokens" />
            <zeebe:input source="=0.2" target="data.temperature" />
            <zeebe:input target="data.topP" />
            <zeebe:input target="data.newDocuments" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="3" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.aws.bedrock.v1" />
            <zeebe:header key="resultExpression" value="={ eddDraftContent: response.body.content, eddDraftModelId: response.body.modelId }" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_EddStartToAi</bpmn:incoming>
        <bpmn:outgoing>Flow_EddAiToReview</bpmn:outgoing>
      </bpmn:serviceTask>
      <bpmn:userTask id="Task_AnalystReviewEddDraft" name="Review EDD draft">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:formDefinition formId="form-review-edd-draft" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_EddAiToReview</bpmn:incoming>
        <bpmn:outgoing>Flow_EddReviewToEnd</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="EndEvent_EddEnd" name="EDD draft ready">
        <bpmn:incoming>Flow_EddReviewToEnd</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_EddStartToAi" sourceRef="StartEvent_EddStart" targetRef="Task_DraftEddWithAi" />
      <bpmn:sequenceFlow id="Flow_EddAiToReview" sourceRef="Task_DraftEddWithAi" targetRef="Task_AnalystReviewEddDraft" />
      <bpmn:sequenceFlow id="Flow_EddReviewToEnd" sourceRef="Task_AnalystReviewEddDraft" targetRef="EndEvent_EddEnd" />
    </bpmn:subProcess>
    <bpmn:userTask id="Task_MlroSignOff" name="Sign off EDD case">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-mlro-sign-off" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_EddToMlroSignOff</bpmn:incoming>
      <bpmn:outgoing>Flow_MlroSignOffToSubmit</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_SubmitMlroApprovalAndChecklist" name="Submit MLRO approval and EDD checklist" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="headers" target="authentication.apiKeyLocation" />
          <zeebe:input target="authentication.name" />
          <zeebe:input target="authentication.value" />
          <zeebe:input target="authentication.username" />
          <zeebe:input target="authentication.password" />
          <zeebe:input target="authentication.token" />
          <zeebe:input target="authentication.oauthTokenEndpoint" />
          <zeebe:input target="authentication.clientId" />
          <zeebe:input target="authentication.clientSecret" />
          <zeebe:input target="authentication.audience" />
          <zeebe:input target="authentication.clientAuthentication" />
          <zeebe:input target="authentication.scopes" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="=&#34;https://clientvault.meridian.local/cdd-cases/&#34; + caseId + &#34;/submit-for-approval&#34;" target="url" />
          <zeebe:input target="headers" />
          <zeebe:input target="queryParameters" />
          <zeebe:input target="storeResponse" />
          <zeebe:input target="skipEncoding" />
          <zeebe:input target="followRedirects" />
          <zeebe:input source="20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="20" target="readTimeoutInSeconds" />
          <zeebe:input source="={ approvalLevel: &#34;MLRO&#34;, approverUsername: mlroApproverUsername, approvalDate: mlroApprovalDate, eddChecklist: { meetingType: meetingType, meetingDate: meetingDate, sourceOfWealthEvidenceSummary: sourceOfWealthEvidenceSummary, independentCorroborationSource: independentCorroborationSource, mlroSignOff: mlroSignOff } }" target="body" />
          <zeebe:input target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="13" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={ mlroSubmitStatus: body.status, mlroSubmitTimestamp: body.timestamp }" />
          <zeebe:header key="errorExpression" value="=if response.statusCode &#62;= 400 then bpmnError(&#34;SUBMIT_APPROVAL_FAILED&#34;, &#34;ClientVault submit-for-approval failed&#34;) else null" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_MlroSignOffToSubmit</bpmn:incoming>
      <bpmn:outgoing>Flow_MlroSubmitToOutcome</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_ReviewOutcomeMerge" name="">
      <bpmn:incoming>Flow_AnalystSubmitToOutcome</bpmn:incoming>
      <bpmn:incoming>Flow_SeniorSubmitToOutcome</bpmn:incoming>
      <bpmn:incoming>Flow_HighSubmitToOutcome</bpmn:incoming>
      <bpmn:incoming>Flow_MlroSubmitToOutcome</bpmn:incoming>
      <bpmn:outgoing>Flow_OutcomeMergeToDecision</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_ReviewDecision" name="Review approved?" default="SequenceFlow_ReviewApproved">
      <bpmn:incoming>Flow_OutcomeMergeToDecision</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_ReviewApproved</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_ReviewRejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_CaseApproved" name="Case approved">
      <bpmn:incoming>SequenceFlow_ReviewApproved</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="Task_PatchCaseUnderReview" name="Set case status to under review" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" />
        <zeebe:ioMapping>
          <zeebe:input source="headers" target="authentication.apiKeyLocation" />
          <zeebe:input target="authentication.name" />
          <zeebe:input target="authentication.value" />
          <zeebe:input target="authentication.username" />
          <zeebe:input target="authentication.password" />
          <zeebe:input target="authentication.token" />
          <zeebe:input target="authentication.oauthTokenEndpoint" />
          <zeebe:input target="authentication.clientId" />
          <zeebe:input target="authentication.clientSecret" />
          <zeebe:input target="authentication.audience" />
          <zeebe:input target="authentication.clientAuthentication" />
          <zeebe:input target="authentication.scopes" />
          <zeebe:input source="PATCH" target="method" />
          <zeebe:input source="=&#34;https://clientvault.meridian.local/cdd-cases/&#34; + caseId" target="url" />
          <zeebe:input target="headers" />
          <zeebe:input target="queryParameters" />
          <zeebe:input target="storeResponse" />
          <zeebe:input target="skipEncoding" />
          <zeebe:input target="followRedirects" />
          <zeebe:input source="20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="20" target="readTimeoutInSeconds" />
          <zeebe:input source="={ status: &#34;UNDER_REVIEW&#34;, rejectionComments: rejectionComments }" target="body" />
          <zeebe:input target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="13" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultExpression" value="={ patchUnderReviewStatus: body.status }" />
          <zeebe:header key="errorExpression" value="=if response.statusCode &#62;= 400 then bpmnError(&#34;PATCH_CASE_FAILED&#34;, &#34;ClientVault PATCH /cdd-cases failed&#34;) else null" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>SequenceFlow_ReviewRejected</bpmn:incoming>
      <bpmn:outgoing>Flow_PatchToRevision</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_AnalystRevision" name="Revise case">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="form-analyst-revision" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_PatchToRevision</bpmn:incoming>
      <bpmn:outgoing>Flow_RevisionToOutcome</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_RevisionOutcome" name="Revision outcome?" default="SequenceFlow_RevisionResubmit">
      <bpmn:incoming>Flow_RevisionToOutcome</bpmn:incoming>
      <bpmn:outgoing>SequenceFlow_RevisionResubmit</bpmn:outgoing>
      <bpmn:outgoing>SequenceFlow_RevisionEscalate</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="EndEvent_CaseEscalated" name="Case escalated">
      <bpmn:incoming>SequenceFlow_RevisionEscalate</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="EndEvent_CaseResubmitted" name="Case resubmitted for re-approval">
      <bpmn:incoming>SequenceFlow_RevisionResubmit</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_StartToGateway" sourceRef="StartEvent_ApprovalRequested" targetRef="Gateway_ApprovalRouting" />
    <bpmn:sequenceFlow id="SequenceFlow_ToAnalystBranch" name="Analyst" sourceRef="Gateway_ApprovalRouting" targetRef="Task_PeerAnalystReview">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">=approvalLevel = "ANALYST"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_ToElevatedBranch" name="Senior manager (elevated)" sourceRef="Gateway_ApprovalRouting" targetRef="Task_SeniorManagerReview" />
    <bpmn:sequenceFlow id="SequenceFlow_ToHighBranch" name="Senior manager (high co-sign)" sourceRef="Gateway_ApprovalRouting" targetRef="ParallelGateway_HighSplit">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">=approvalLevel = "SENIOR_MANAGER" and newRiskTier = "HIGH"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="SequenceFlow_ToMlroBranch" name="MLRO" sourceRef="Gateway_ApprovalRouting" targetRef="SubProcess_EddInvestigation">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">=approvalLevel = "MLRO"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PeerReviewToSubmit" sourceRef="Task_PeerAnalystReview" targetRef="Task_SubmitAnalystApproval" />
    <bpmn:sequenceFlow id="Flow_AnalystSubmitToOutcome" sourceRef="Task_SubmitAnalystApproval" targetRef="Gateway_ReviewOutcomeMerge" />
    <bpmn:sequenceFlow id="Flow_SeniorReviewToSubmit" sourceRef="Task_SeniorManagerReview" targetRef="Task_SubmitSeniorApproval" />
    <bpmn:sequenceFlow id="Flow_SeniorSubmitToOutcome" sourceRef="Task_SubmitSeniorApproval" targetRef="Gateway_ReviewOutcomeMerge" />
    <bpmn:sequenceFlow id="Flow_HighSplitToSenior" sourceRef="ParallelGateway_HighSplit" targetRef="Task_HighSeniorManagerReview" />
    <bpmn:sequenceFlow id="Flow_HighSplitToCompliance" sourceRef="ParallelGateway_HighSplit" targetRef="Task_HighComplianceReview" />
    <bpmn:sequenceFlow id="Flow_HighSeniorToJoin" sourceRef="Task_HighSeniorManagerReview" targetRef="ParallelGateway_HighJoin" />
    <bpmn:sequenceFlow id="Flow_HighComplianceToJoin" sourceRef="Task_HighComplianceReview" targetRef="ParallelGateway_HighJoin" />
    <bpmn:sequenceFlow id="Flow_HighJoinToSubmit" sourceRef="ParallelGateway_HighJoin" targetRef="Task_SubmitHighApprovalAndNote" />
    <bpmn:sequenceFlow id="Flow_HighSubmitToOutcome" sourceRef="Task_SubmitHighApprovalAndNote" targetRef="Gateway_ReviewOutcomeMerge" />
    <bpmn:sequenceFlow id="Flow_EddToMlroSignOff" sourceRef="SubProcess_EddInvestigation" targetRef="Task_MlroSignOff" />
    <bpmn:sequenceFlow id="Flow_MlroSignOffToSubmit" sourceRef="Task_MlroSignOff" targetRef="Task_SubmitMlroApprovalAndChecklist" />
    <bpmn:sequenceFlow id="Flow_MlroSubmitToOutcome" sourceRef="Task_SubmitMlroApprovalAndChecklist" targetRef="Gateway_ReviewOutcomeMerge" />
    <bpmn:sequenceFlow id="Flow_OutcomeMergeToDecision" sourceRef="Gateway_ReviewOutcomeMerge" targetRef="Gateway_ReviewDecision" />
    <bpmn:sequenceFlow id="SequenceFlow_ReviewApproved" name="Approved" sourceRef="Gateway_ReviewDecision" targetRef="EndEvent_CaseApproved" />
    <bpmn:sequenceFlow id="SequenceFlow_ReviewRejected" name="Rejected" sourceRef="Gateway_ReviewDecision" targetRef="Task_PatchCaseUnderReview">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">=reviewOutcome = "reject_back_to_analyst"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_PatchToRevision" sourceRef="Task_PatchCaseUnderReview" targetRef="Task_AnalystRevision" />
    <bpmn:sequenceFlow id="Flow_RevisionToOutcome" sourceRef="Task_AnalystRevision" targetRef="Gateway_RevisionOutcome" />
    <bpmn:sequenceFlow id="SequenceFlow_RevisionResubmit" name="Revise and resubmit" sourceRef="Gateway_RevisionOutcome" targetRef="EndEvent_CaseResubmitted" />
    <bpmn:sequenceFlow id="SequenceFlow_RevisionEscalate" name="Escalate" sourceRef="Gateway_RevisionOutcome" targetRef="EndEvent_CaseEscalated">
      <bpmn:conditionExpression xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:type="bpmn:tFormalExpression">=analystRevisionOutcome = "escalate"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:textAnnotation id="TextAnnotation_Start">
      <bpmn:text>Triggered by: Phase 7 (DMN risk-tier output) — sets approvalLevel and newRiskTier on the case.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_Routing">
      <bpmn:text>Evaluates: approvalLevel, newRiskTier, eddRequired</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_PeerReview">
      <bpmn:text>Manual: Peer review attestation closes the FCA Q4 2024 ~15% missing-approver gap; cannot be automated. Implementation: Camunda User Task assigned to kyc-analysts group with rule assignee != case.assignedAnalyst; non-interrupting timer 24h notifies kyc-team-lead; interrupting timer 5 business days escalates to KYC team lead.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_AnalystSubmit">
      <bpmn:text>Implementation: ClientVault REST connector POST /cdd-cases/{caseId}/submit-for-approval with approvalLevel: ANALYST and validated approverUsername/approvalDate (pre-flight completeness guard). HTTP 4xx/5xx routes to incident-handler.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_SeniorReview">
      <bpmn:text>Manual: Senior manager attestation on ELEVATED-tier risk profile; section-166 exposure sits with the named approver. Implementation: Camunda User Task assigned to kyc-senior-managers group; non-interrupting timer 48h notifies kyc-team-lead; interrupting timer 7 business days escalates to MLRO.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_SeniorSubmit">
      <bpmn:text>Implementation: ClientVault REST connector POST /cdd-cases/{caseId}/submit-for-approval with approvalLevel: SENIOR_MANAGER. Same pre-flight completeness guard and HTTP error routing as analyst branch.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_HighSeniorReview">
      <bpmn:text>Manual: HIGH-tier dual co-sign mandated by Hard Constraint #10 (non-delegable human judgement). Implementation: Camunda User Task assigned to kyc-senior-managers group; produces seniorApproverUsername/seniorApprovalDate; same SLA timers as elevated branch.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_HighComplianceReview">
      <bpmn:text>Manual: Compliance officer co-sign — independent of senior manager review (no data dependency); parallelization advances cycle time without weakening Hard Constraint #10. Implementation: Camunda User Task assigned to compliance-officers group; produces complianceApproverUsername/complianceApprovalDate; same SLA timers.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_HighSubmit">
      <bpmn:text>Implementation: ClientVault REST connector POST /cdd-cases/{caseId}/submit-for-approval (approvalLevel: SENIOR_MANAGER, last-completed approver) plus POST /cdd-cases/{caseId}/notes capturing both approver identities and dual-cosign rationale. Wrapped in transaction subprocess so a failed audit note rolls back the submit (preserves Hard Constraint #12).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_EddSubprocess">
      <bpmn:text>Implementation: AWS Bedrock (Claude Sonnet) drafts registry summaries, adverse-media digests, and source-of-wealth narratives; analyst review gate is unconditional (no auto-apply branch) per Hard Constraint #1. Bedrock connector failure falls back to manual analyst investigation.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_MlroSignOff">
      <bpmn:text>Manual: MLRO sign-off is non-delegable human judgement under JMLSG section 5.5.34; criminal liability under MLR 2017. Implementation: Camunda User Task with extended EDD checklist form (meetingType, meetingDate, sourceOfWealthEvidenceSummary, independentCorroborationSource, mlroSignOff); assigned to mlro group (Deputy MLRO permitted up to 12 weeks rolling per JMLSG section 3.19); non-interrupting timer 72h notifies kyc-team-lead; interrupting timer 10 business days escalates to Head of Compliance.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_MlroSubmit">
      <bpmn:text>Implementation: Transaction subprocess wrapping ClientVault REST POST /cdd-cases/{caseId}/submit-for-approval (approvalLevel: MLRO) and POST /cdd-cases/{caseId}/notes (serialised EDD checklist) — atomic per Hard Constraint #12 to prevent FCA-flagged failure mode of approved case with missing checklist note.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_OutcomeDecision">
      <bpmn:text>Evaluates: peerReviewOutcome / seniorReviewOutcome / complianceReviewOutcome / mlroOutcome (whichever applies for the taken branch)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_Patch">
      <bpmn:text>Implementation: ClientVault REST connector PATCH /cdd-cases/{caseId} setting case.status: UNDER_REVIEW with rejectionComments. HTTP 4xx/5xx routes to incident-handler.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_Revision">
      <bpmn:text>Manual: Revise/escalate decision is genuine human judgement; rare and requires triage. Implementation: Camunda User Task assigned to original case.assignedAnalyst (NOT a peer); non-interrupting timer 48h notifies kyc-team-lead; interrupting timer 5 business days escalates.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_RevisionOutcome">
      <bpmn:text>Evaluates: analystRevisionOutcome (revise_and_resubmit | escalate)</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_Approved">
      <bpmn:text>Follow-up: Phase 9 (closure) — case.status: APPROVED; SLA dashboard event emitted (caseId, branch taken, approver IDs, durations) to ClientVault /notes (noteType: SYSTEM).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_Resubmitted">
      <bpmn:text>Follow-up: Re-enters Phase 8 at Gateway-1 (manualRiskTier unchanged) or Phase 7 DMN (manualRiskTier changed per JMLSG section 4.50).</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_Escalated">
      <bpmn:text>Follow-up: Routes upward to KYC team lead / MLRO per H-I5 exit shape.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_Start" associationDirection="None" sourceRef="StartEvent_ApprovalRequested" targetRef="TextAnnotation_Start" />
    <bpmn:association id="Association_Routing" associationDirection="None" sourceRef="Gateway_ApprovalRouting" targetRef="TextAnnotation_Routing" />
