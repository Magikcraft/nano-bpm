    <bpmn:association id="Association_OutcomeDecision" associationDirection="None" sourceRef="Gateway_ReviewDecision" targetRef="TextAnnotation_OutcomeDecision" />
    <bpmn:association id="Association_Patch" associationDirection="None" sourceRef="Task_PatchCaseUnderReview" targetRef="TextAnnotation_Patch" />
    <bpmn:association id="Association_Revision" associationDirection="None" sourceRef="Task_AnalystRevision" targetRef="TextAnnotation_Revision" />
    <bpmn:association id="Association_RevisionOutcome" associationDirection="None" sourceRef="Gateway_RevisionOutcome" targetRef="TextAnnotation_RevisionOutcome" />
    <bpmn:association id="Association_Approved" associationDirection="None" sourceRef="EndEvent_CaseApproved" targetRef="TextAnnotation_Approved" />
    <bpmn:association id="Association_Resubmitted" associationDirection="None" sourceRef="EndEvent_CaseResubmitted" targetRef="TextAnnotation_Resubmitted" />
    <bpmn:association id="Association_Escalated" associationDirection="None" sourceRef="EndEvent_CaseEscalated" targetRef="TextAnnotation_Escalated" />
  </bpmn:process>
