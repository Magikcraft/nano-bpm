<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn">

  <bpmn:process id="loan-approval" name="Loan Approval" isExecutable="true">

    <bpmn:startEvent id="StartEvent_1" name="Application Submitted">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_CreditCheck" name="Run Credit Check">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="credit-check"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:serviceTask>

    <!-- Error boundary: credit bureau unreachable -->
    <bpmn:boundaryEvent id="BoundaryEvent_CreditError" name="Credit Bureau Error" attachedToRef="Task_CreditCheck">
      <bpmn:outgoing>Flow_CreditError</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_Credit" errorRef="Error_CreditBureau"/>
    </bpmn:boundaryEvent>

    <bpmn:exclusiveGateway id="Gateway_CreditScore" name="Credit Score OK?">
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_Rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:sequenceFlow id="Flow_Approved" name="score >= 700"
      sourceRef="Gateway_CreditScore" targetRef="Task_ApproveLoan">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=creditScore >= 700</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:sequenceFlow id="Flow_Rejected" name="score &lt; 700"
      sourceRef="Gateway_CreditScore" targetRef="Task_RejectApplication">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=creditScore &lt; 700</bpmn:conditionExpression>
    </bpmn:sequenceFlow>

    <bpmn:serviceTask id="Task_ApproveLoan" name="Approve Loan">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="approve-loan"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Approved</bpmn:incoming>
      <bpmn:outgoing>Flow_ToApprovedEnd</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_RejectApplication" name="Reject Application">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="reject-application"/>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Rejected</bpmn:incoming>
      <bpmn:outgoing>Flow_ToRejectedEnd</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_Approved" name="Loan Approved">
      <bpmn:incoming>Flow_ToApprovedEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Rejected" name="Application Rejected">
      <bpmn:incoming>Flow_ToRejectedEnd</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_CreditError" name="Credit Bureau Unavailable">
      <bpmn:incoming>Flow_CreditError</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_1" targetRef="Task_CreditCheck"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_CreditCheck" targetRef="Gateway_CreditScore"/>
    <bpmn:sequenceFlow id="Flow_ToApprovedEnd" sourceRef="Task_ApproveLoan" targetRef="EndEvent_Approved"/>
    <bpmn:sequenceFlow id="Flow_ToRejectedEnd" sourceRef="Task_RejectApplication" targetRef="EndEvent_Rejected"/>
    <bpmn:sequenceFlow id="Flow_CreditError" sourceRef="BoundaryEvent_CreditError" targetRef="EndEvent_CreditError"/>

  </bpmn:process>

  <bpmn:error id="Error_CreditBureau" name="Credit Bureau Error" errorCode="CREDIT_BUREAU_ERROR"/>

  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="loan-approval">

      <!-- Start event -->
      <bpmndi:BPMNShape id="Shape_StartEvent_1" bpmnElement="StartEvent_1">
        <dc:Bounds x="132" y="152" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="108" y="195" width="84" height="27"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Run Credit Check -->
      <bpmndi:BPMNShape id="Shape_Task_CreditCheck" bpmnElement="Task_CreditCheck">
        <dc:Bounds x="230" y="130" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <!-- Error boundary on credit check -->
      <bpmndi:BPMNShape id="Shape_BoundaryEvent_CreditError" bpmnElement="BoundaryEvent_CreditError">
        <dc:Bounds x="294" y="192" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="323" y="232" width="68" height="27"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Credit Score gateway -->
      <bpmndi:BPMNShape id="Shape_Gateway_CreditScore" bpmnElement="Gateway_CreditScore" isMarkerVisible="true">
        <dc:Bounds x="405" y="145" width="50" height="50"/>
        <bpmndi:BPMNLabel><dc:Bounds x="388" y="202" width="84" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Approve Loan -->
      <bpmndi:BPMNShape id="Shape_Task_ApproveLoan" bpmnElement="Task_ApproveLoan">
        <dc:Bounds x="540" y="80" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <!-- Reject Application -->
      <bpmndi:BPMNShape id="Shape_Task_RejectApplication" bpmnElement="Task_RejectApplication">
        <dc:Bounds x="540" y="220" width="100" height="80"/>
      </bpmndi:BPMNShape>

      <!-- End: Loan Approved -->
      <bpmndi:BPMNShape id="Shape_EndEvent_Approved" bpmnElement="EndEvent_Approved">
        <dc:Bounds x="712" y="102" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="695" y="145" width="70" height="27"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- End: Application Rejected -->
      <bpmndi:BPMNShape id="Shape_EndEvent_Rejected" bpmnElement="EndEvent_Rejected">
        <dc:Bounds x="712" y="242" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="689" y="285" width="82" height="27"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- End: Credit Bureau Unavailable -->
      <bpmndi:BPMNShape id="Shape_EndEvent_CreditError" bpmnElement="EndEvent_CreditError">
        <dc:Bounds x="294" y="322" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="268" y="365" width="88" height="27"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>

      <!-- Flow_1: Start → Credit Check -->
      <bpmndi:BPMNEdge id="Edge_Flow_1" bpmnElement="Flow_1">
        <di:waypoint x="168" y="170"/>
        <di:waypoint x="230" y="170"/>
      </bpmndi:BPMNEdge>

      <!-- Flow_2: Credit Check → Gateway -->
      <bpmndi:BPMNEdge id="Edge_Flow_2" bpmnElement="Flow_2">
        <di:waypoint x="330" y="170"/>
        <di:waypoint x="405" y="170"/>
      </bpmndi:BPMNEdge>

      <!-- Flow_Approved: Gateway → Approve Loan -->
      <bpmndi:BPMNEdge id="Edge_Flow_Approved" bpmnElement="Flow_Approved">
        <di:waypoint x="430" y="145"/>
        <di:waypoint x="430" y="120"/>
        <di:waypoint x="540" y="120"/>
        <bpmndi:BPMNLabel><dc:Bounds x="455" y="103" width="68" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <!-- Flow_Rejected: Gateway → Reject Application -->
      <bpmndi:BPMNEdge id="Edge_Flow_Rejected" bpmnElement="Flow_Rejected">
        <di:waypoint x="430" y="195"/>
        <di:waypoint x="430" y="260"/>
        <di:waypoint x="540" y="260"/>
        <bpmndi:BPMNLabel><dc:Bounds x="455" y="263" width="60" height="14"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>

      <!-- Flow_ToApprovedEnd: Approve Loan → End Approved -->
      <bpmndi:BPMNEdge id="Edge_Flow_ToApprovedEnd" bpmnElement="Flow_ToApprovedEnd">
        <di:waypoint x="640" y="120"/>
        <di:waypoint x="712" y="120"/>
      </bpmndi:BPMNEdge>

      <!-- Flow_ToRejectedEnd: Reject Application → End Rejected -->
      <bpmndi:BPMNEdge id="Edge_Flow_ToRejectedEnd" bpmnElement="Flow_ToRejectedEnd">
        <di:waypoint x="640" y="260"/>
        <di:waypoint x="712" y="260"/>
      </bpmndi:BPMNEdge>

      <!-- Flow_CreditError: Boundary → End Credit Error -->
      <bpmndi:BPMNEdge id="Edge_Flow_CreditError" bpmnElement="Flow_CreditError">
        <di:waypoint x="312" y="228"/>
        <di:waypoint x="312" y="322"/>
      </bpmndi:BPMNEdge>

    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>

</bpmn:definitions>
