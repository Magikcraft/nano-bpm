<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_DeliveryException" targetNamespace="http://amazingretail.example/bpmn/delivery-exception" exporter="Camunda Modeler" exporterVersion="5.46.1" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:error id="Error_OrderNotFound" name="Order Not Found" errorCode="ORDER_NOT_FOUND" />
  <bpmn:process id="delivery-exception-resolution" name="Delivery Exception Resolution" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Intake" name="Delivery exception submitted">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="form-delivery-exception-intake" />
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_Start_CheckDuplicate</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_CheckDuplicate" name="Check for existing Salesforce case">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-for-duplicate-case" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_CheckDuplicate</bpmn:incoming>
      <bpmn:outgoing>Flow_CheckDuplicate_GW</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_DuplicateExists" name="Case exists?" default="Flow_GW_CreateCase">
      <bpmn:incoming>Flow_CheckDuplicate_GW</bpmn:incoming>
      <bpmn:outgoing>Flow_GW_CreateCase</bpmn:outgoing>
      <bpmn:outgoing>Flow_GW_LoadCase</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_CreateNewCase" name="Create new Salesforce case">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="create-new-case" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_GW_CreateCase</bpmn:incoming>
      <bpmn:outgoing>Flow_Create_Merge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_UpdateExistingCase" name="Update existing case">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="update-existing-case" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_GW_LoadCase</bpmn:incoming>
      <bpmn:outgoing>Flow_Update_Merge</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_MergeCase">
      <bpmn:incoming>Flow_Create_Merge</bpmn:incoming>
      <bpmn:incoming>Flow_Update_Merge</bpmn:incoming>
      <bpmn:outgoing>Flow_Merge_FetchData</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_FetchTrackingData" name="Fetch order and tracking data">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="fetch-tracking-data" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Merge_FetchData</bpmn:incoming>
      <bpmn:outgoing>Flow_Fetch_Classify</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="BoundaryEvent_OrderNotFound" name="Order not found" attachedToRef="Task_FetchTrackingData">
      <bpmn:outgoing>Flow_OrderNotFound_Reject</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_OrderNotFound" errorRef="Error_OrderNotFound" />
    </bpmn:boundaryEvent>
    <bpmn:businessRuleTask id="Task_ClassifyException" name="Classify delivery exception">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="delivery-exception-classification" resultVariable="classificationOutput" />
        <zeebe:ioMapping>
          <zeebe:output source="=classificationOutput.classificationResult" target="classificationResult" />
          <zeebe:output source="=classificationOutput.routingReason" target="routingReason" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Fetch_Classify</bpmn:incoming>
      <bpmn:outgoing>Flow_Classify_Route</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="Gateway_Route" name="Classification?" default="Flow_Route_Investigate">
      <bpmn:incoming>Flow_Classify_Route</bpmn:incoming>
      <bpmn:outgoing>Flow_Route_Reject</bpmn:outgoing>
      <bpmn:outgoing>Flow_Route_Investigate</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_UpdateCaseReject" name="Update Salesforce case">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="update-salesforce-case" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Route_Reject</bpmn:incoming>
      <bpmn:incoming>Flow_OrderNotFound_Reject</bpmn:incoming>
      <bpmn:outgoing>Flow_UpdateReject_DraftEmail</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:scriptTask id="Task_DraftEmail" name="Draft customer email">
      <bpmn:extensionElements>
        <zeebe:script expression="={emailSubject: &#34;RE: Delivery Exception&#34; + (if orderId != null then &#34; - Order &#34; + orderId else &#34;&#34;), emailDraftFinal: if classificationResult = &#34;order_not_found&#34; then &#34;Dear &#34; + (if customerName != null then customerName else &#34;Valued Customer&#34;) + &#34;,&#10;&#10;Thank you for contacting Amazing Retail support.&#10;&#10;We were unable to locate order &#34; + (if orderId != null then orderId else &#34;unknown&#34;) + &#34; in our system. Please verify the order ID and contact us again, or reply to this email with your original order confirmation.&#10;&#10;We apologize for any inconvenience.&#10;&#10;Best regards,&#10;Amazing Retail Customer Experience Team&#34; else &#34;Dear &#34; + (if customerName != null then customerName else &#34;Valued Customer&#34;) + &#34;,&#10;&#10;Thank you for reaching out about your delivery concern for order &#34; + (if orderId != null then orderId else &#34;unknown&#34;) + &#34;.&#10;&#10;After reviewing your case and the available tracking information, we have completed our investigation. Our records confirm that this delivery was completed successfully and therefore we are unable to process a compensation claim for this order.&#10;&#10;&#34; + (if routingReason != null then &#34;Details: &#34; + routingReason + &#34;&#10;&#10;&#34; else &#34;&#34;) + &#34;If you believe this is an error, please reply to this email with any additional documentation or evidence and we will be happy to review your case again.&#10;&#10;We value your business and apologize for any frustration.&#10;&#10;Best regards,&#10;Amazing Retail Customer Experience Team&#34;}" resultVariable="emailDraft" />
        <zeebe:ioMapping>
          <zeebe:output source="=emailDraft.emailSubject" target="emailSubject" />
          <zeebe:output source="=emailDraft.emailDraftFinal" target="emailDraftFinal" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_UpdateReject_DraftEmail</bpmn:incoming>
      <bpmn:outgoing>Flow_Draft_ReviewEmail</bpmn:outgoing>
    </bpmn:scriptTask>
    <bpmn:userTask id="Task_ReviewEmail" name="Review and approve email draft">
      <bpmn:extensionElements>
        <zeebe:formDefinition formId="form-review-email-draft" />
        <zeebe:userTask />
        <zeebe:assignmentDefinition candidateGroups="cx-specialists" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Draft_ReviewEmail</bpmn:incoming>
      <bpmn:outgoing>Flow_0hj03d7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_SendEmail" name="Send customer email" zeebe:modelerTemplate="io.camunda.connectors.email.v1" zeebe:modelerTemplateVersion="4" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:email:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="simple" target="authentication.type" />
          <zeebe:input source="{{secrets.GMAIL_INBOX_USER}}" target="authentication.username" />
          <zeebe:input source="{{secrets.GMAIL_INBOX_PASSWORD}}" target="authentication.password" />
          <zeebe:input source="smtp" target="protocol" />
          <zeebe:input source="smtp.gmail.com" target="data.smtpConfig.smtpHost" />
          <zeebe:input source="=587" target="data.smtpConfig.smtpPort" />
          <zeebe:input source="TLS" target="data.smtpConfig.smtpCryptographicProtocol" />
          <zeebe:input source="sendEmailSmtp" target="data.smtpActionDiscriminator" />
          <zeebe:input source="{{secrets.GMAIL_INBOX_USER}}" target="data.smtpAction.from" />
          <zeebe:input source="=customerEmail" target="data.smtpAction.to" />
          <zeebe:input source="=emailSubject" target="data.smtpAction.subject" />
          <zeebe:input source="PLAIN" target="data.smtpAction.contentType" />
          <zeebe:input source="=emailDraftFinal" target="data.smtpAction.body" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="4" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.email.v1" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_0hj03d7</bpmn:incoming>
      <bpmn:outgoing>Flow_Send_CloseCase</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CloseCase" name="Close Salesforce case">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="close-salesforce-case" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Send_CloseCase</bpmn:incoming>
      <bpmn:outgoing>Flow_CloseCase_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Done" name="Case resolved">
      <bpmn:incoming>Flow_CloseCase_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:adHocSubProcess id="SubProcess_AgentInvestigation" name="Agentic investigation" zeebe:modelerTemplate="io.camunda.connectors.agenticai.aiagent.jobworker.v1" zeebe:modelerTemplateVersion="7" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,PHN2ZyB3aWR0aD0iMzIiIGhlaWdodD0iMzIiIHZpZXdCb3g9IjAgMCAzMiAzMiIgZmlsbD0ibm9uZSIgeG1sbnM9Imh0dHA6Ly93d3cudzMub3JnLzIwMDAvc3ZnIj48Y2lyY2xlIGN4PSIxNiIgY3k9IjE2IiByPSIxNiIgZmlsbD0iI0E1NkVGRiIvPjwvc3ZnPg==">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda.agenticai:aiagent-job-worker:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="bedrock" target="provider.type" />
          <zeebe:input source="eu-central-1" target="provider.bedrock.region" />
          <zeebe:input source="credentials" target="provider.bedrock.authentication.type" />
          <zeebe:input source="{{secrets.AWS_BEDROCK_ACCESS_KEY}}" target="provider.bedrock.authentication.accessKey" />
          <zeebe:input source="{{secrets.AWS_BEDROCK_SECRET_KEY}}" target="provider.bedrock.authentication.secretKey" />
          <zeebe:input source="global.anthropic.claude-sonnet-4-5-20250929-v1:0" target="provider.bedrock.model.model" />
          <zeebe:input source="=&#34;You are a delivery exception investigation agent for Amazing Retail CX team.&#10;&#10;Your job:&#10;1. Review the case context provided.&#10;2. Choose the correct action: Issue goodwill credit (if carrier caused the delay) or Reject case (if delivery was confirmed).&#10;3. After taking the action, call the Review and approve email draft tool. Pass a professionally written email body as the emailDraftFinal parameter. Address the customer by their email if available.&#10;4. Once the review tool completes, provide a brief summary as your final response.&#10;&#10;Important: Do not call any tool twice. Do not include internal reasoning in the email body.&#34;" target="data.systemPrompt.prompt" />
          <zeebe:input source="=&#34;Delivery Exception Case&#10;&#10;Order ID: &#34; + (if orderId != null then orderId else &#34;unknown&#34;) + &#34;&#10;Customer: &#34; + (if customerEmail != null then customerEmail else &#34;unknown&#34;) + &#34;&#10;Dispute: &#34; + (if disputeDescription != null then disputeDescription else &#34;not provided&#34;) + &#34;&#10;Classification: &#34; + (if classificationResult != null then classificationResult else &#34;unclear&#34;) + &#34;&#10;Reason: &#34; + (if routingReason != null then routingReason else &#34;n/a&#34;) + &#34;&#10;Tracking events: &#34; + (if trackingEvents != null then string(trackingEvents) else &#34;not available&#34;) + &#34;&#10;&#10;Please investigate and resolve this case.&#34;" target="data.userPrompt.prompt" />
          <zeebe:input source="in-process" target="data.memory.storage.type" />
          <zeebe:input source="=20" target="data.memory.contextWindowSize" />
          <zeebe:input source="=10" target="data.limits.maxModelCalls" />
          <zeebe:input source="WAIT_FOR_TOOL_CALL_RESULTS" target="data.events.behavior" />
          <zeebe:input source="text" target="data.response.format.type" />
          <zeebe:input source="=false" target="data.response.format.parseJson" />
          <zeebe:input source="=false" target="data.response.includeAssistantMessage" />
          <zeebe:input source="=false" target="data.response.includeAgentContext" />
          <zeebe:input target="agentContext" />
          <zeebe:input target="agent" />
          <zeebe:output source="=agent" target="agent" />
          <zeebe:output source="=agent.responseText" target="agentSummary" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="7" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.agenticai.aiagent.jobworker.v1" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
        <zeebe:adHoc outputCollection="toolCallResults" outputElement="={id: toolCall._meta.id, name: toolCall._meta.name, content: toolCallResult}" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Route_Investigate</bpmn:incoming>
      <bpmn:outgoing>Flow_AgentSP_CloseCase</bpmn:outgoing>
      <bpmn:serviceTask id="Task_AgentIssueCredit" name="Issue goodwill credit" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="=fromAi(toolCall.creditAmount, &#34;Credit amount in EUR to issue as goodwill compensation&#34;, &#34;number&#34;)" target="creditAmount" />
            <zeebe:input source="noAuth" target="authentication.type" />
            <zeebe:input source="POST" target="method" />
            <zeebe:input source="=&#34;http://localhost:8002/payments/&#34; + invoiceId + &#34;/credit&#34;" target="url" />
            <zeebe:input source="={amount: creditAmount, reason: &#34;goodwill&#34;, notes: &#34;Goodwill credit issued by automated delivery exception resolution&#34;}" target="body" />
            <zeebe:input source="=false" target="storeResponse" />
            <zeebe:input source="=false" target="followRedirects" />
            <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
            <zeebe:input source="=20" target="readTimeoutInSeconds" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="13" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
            <zeebe:header key="resultExpression" value="={creditId: response.body.credit_id, creditAmount: response.body.amount, toolCallResult: &#34;Goodwill credit of EUR &#34; + string(response.body.amount) + &#34; issued successfully. Credit ID: &#34; + response.body.credit_id}" />
            <zeebe:header key="retryBackoff" value="PT0S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:serviceTask id="Task_AgentRejectCase" name="Reject case">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="reject-case" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="=fromAi(toolCall.rejectionReason, &#34;Reason for rejecting the customer claim&#34;, &#34;string&#34;)" target="rejectionReason" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
      </bpmn:serviceTask>
      <bpmn:userTask id="Task_AgentReviewEmail" name="Review and approve email draft">
        <bpmn:extensionElements>
          <zeebe:formDefinition formId="form-review-email-draft" />
          <zeebe:userTask />
          <zeebe:assignmentDefinition candidateGroups="cx-specialists" />
          <zeebe:ioMapping>
            <zeebe:input source="=fromAi(toolCall.emailDraftFinal, &#34;Full email body to send to the customer&#34;, &#34;string&#34;)" target="emailDraftFinal" />
            <zeebe:input source="=if orderId != null then &#34;RE: Delivery Exception - Order &#34; + orderId else &#34;RE: Delivery Exception&#34;" target="emailSubject" />
            <zeebe:output source="={decision: approvalDecision, emailBody: emailDraftFinal}" target="toolCallResult" />
            <zeebe:output source="=emailDraftFinal" target="emailDraftFinal" />
            <zeebe:output source="=approvalDecision" target="approvalDecision" />
          </zeebe:ioMapping>
        </bpmn:extensionElements>
        <bpmn:outgoing>Flow_AgentReview_GW</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:exclusiveGateway id="Gateway_AgentEmailApprove" name="Email approved?" default="Flow_AgentApprove_Send">
        <bpmn:incoming>Flow_AgentReview_GW</bpmn:incoming>
        <bpmn:outgoing>Flow_AgentApprove_Send</bpmn:outgoing>
        <bpmn:outgoing>Flow_AgentApprove_Reject</bpmn:outgoing>
      </bpmn:exclusiveGateway>
      <bpmn:serviceTask id="Task_AgentSendEmail" name="Send customer email" zeebe:modelerTemplate="io.camunda.connectors.email.v1" zeebe:modelerTemplateVersion="4" zeebe:modelerTemplateIcon="data:image/svg+xml;base64,">
        <bpmn:extensionElements>
          <zeebe:taskDefinition type="io.camunda:email:1" retries="3" />
          <zeebe:ioMapping>
            <zeebe:input source="simple" target="authentication.type" />
            <zeebe:input source="{{secrets.GMAIL_INBOX_USER}}" target="authentication.username" />
            <zeebe:input source="{{secrets.GMAIL_INBOX_PASSWORD}}" target="authentication.password" />
            <zeebe:input source="smtp" target="protocol" />
            <zeebe:input source="smtp.gmail.com" target="data.smtpConfig.smtpHost" />
            <zeebe:input source="=587" target="data.smtpConfig.smtpPort" />
            <zeebe:input source="TLS" target="data.smtpConfig.smtpCryptographicProtocol" />
            <zeebe:input source="sendEmailSmtp" target="data.smtpActionDiscriminator" />
            <zeebe:input source="{{secrets.GMAIL_INBOX_USER}}" target="data.smtpAction.from" />
            <zeebe:input source="=customerEmail" target="data.smtpAction.to" />
            <zeebe:input source="=if orderId != null then &#34;RE: Delivery Exception - Order &#34; + orderId else &#34;RE: Delivery Exception&#34;" target="data.smtpAction.subject" />
            <zeebe:input source="PLAIN" target="data.smtpAction.contentType" />
            <zeebe:input source="=emailDraftFinal" target="data.smtpAction.body" />
          </zeebe:ioMapping>
          <zeebe:taskHeaders>
            <zeebe:header key="elementTemplateVersion" value="4" />
            <zeebe:header key="elementTemplateId" value="io.camunda.connectors.email.v1" />
            <zeebe:header key="retryBackoff" value="PT0S" />
          </zeebe:taskHeaders>
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_AgentApprove_Send</bpmn:incoming>
      </bpmn:serviceTask>
      <bpmn:intermediateThrowEvent id="Event_AgentEmailRejected" name="Email rejected">
        <bpmn:incoming>Flow_AgentApprove_Reject</bpmn:incoming>
      </bpmn:intermediateThrowEvent>
      <bpmn:sequenceFlow id="Flow_AgentReview_GW" sourceRef="Task_AgentReviewEmail" targetRef="Gateway_AgentEmailApprove" />
      <bpmn:sequenceFlow id="Flow_AgentApprove_Send" sourceRef="Gateway_AgentEmailApprove" targetRef="Task_AgentSendEmail" />
      <bpmn:sequenceFlow id="Flow_AgentApprove_Reject" sourceRef="Gateway_AgentEmailApprove" targetRef="Event_AgentEmailRejected">
        <bpmn:conditionExpression>=approvalDecision = "reject"</bpmn:conditionExpression>
      </bpmn:sequenceFlow>
    </bpmn:adHocSubProcess>
    <bpmn:serviceTask id="Task_CloseCase2" name="Close Salesforce case">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="close-salesforce-case" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_AgentSP_CloseCase</bpmn:incoming>
      <bpmn:outgoing>Flow_CloseCase2_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_AgentDone" name="Case resolved">
      <bpmn:incoming>Flow_CloseCase2_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_CheckDuplicate" sourceRef="StartEvent_Intake" targetRef="Task_CheckDuplicate" />
    <bpmn:sequenceFlow id="Flow_CheckDuplicate_GW" sourceRef="Task_CheckDuplicate" targetRef="Gateway_DuplicateExists" />
    <bpmn:sequenceFlow id="Flow_GW_CreateCase" sourceRef="Gateway_DuplicateExists" targetRef="Task_CreateNewCase" />
    <bpmn:sequenceFlow id="Flow_GW_LoadCase" sourceRef="Gateway_DuplicateExists" targetRef="Task_UpdateExistingCase">
      <bpmn:conditionExpression>=isDuplicate</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Create_Merge" sourceRef="Task_CreateNewCase" targetRef="Gateway_MergeCase" />
    <bpmn:sequenceFlow id="Flow_Update_Merge" sourceRef="Task_UpdateExistingCase" targetRef="Gateway_MergeCase" />
    <bpmn:sequenceFlow id="Flow_Merge_FetchData" sourceRef="Gateway_MergeCase" targetRef="Task_FetchTrackingData" />
    <bpmn:sequenceFlow id="Flow_OrderNotFound_Reject" sourceRef="BoundaryEvent_OrderNotFound" targetRef="Task_UpdateCaseReject" />
    <bpmn:sequenceFlow id="Flow_Fetch_Classify" sourceRef="Task_FetchTrackingData" targetRef="Task_ClassifyException" />
    <bpmn:sequenceFlow id="Flow_Classify_Route" sourceRef="Task_ClassifyException" targetRef="Gateway_Route" />
    <bpmn:sequenceFlow id="Flow_Route_Reject" name="rejection" sourceRef="Gateway_Route" targetRef="Task_UpdateCaseReject">
      <bpmn:conditionExpression>=classificationResult = "deterministic-reject"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Route_Investigate" name="unclear" sourceRef="Gateway_Route" targetRef="SubProcess_AgentInvestigation" />
    <bpmn:sequenceFlow id="Flow_UpdateReject_DraftEmail" sourceRef="Task_UpdateCaseReject" targetRef="Task_DraftEmail" />
    <bpmn:sequenceFlow id="Flow_Draft_ReviewEmail" sourceRef="Task_DraftEmail" targetRef="Task_ReviewEmail" />
    <bpmn:sequenceFlow id="Flow_Send_CloseCase" sourceRef="Task_SendEmail" targetRef="Task_CloseCase" />
    <bpmn:sequenceFlow id="Flow_CloseCase_End" sourceRef="Task_CloseCase" targetRef="EndEvent_Done" />
    <bpmn:sequenceFlow id="Flow_AgentSP_CloseCase" sourceRef="SubProcess_AgentInvestigation" targetRef="Task_CloseCase2" />
    <bpmn:sequenceFlow id="Flow_CloseCase2_End" sourceRef="Task_CloseCase2" targetRef="EndEvent_AgentDone" />
    <bpmn:sequenceFlow id="Flow_0hj03d7" sourceRef="Task_ReviewEmail" targetRef="Task_SendEmail" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="delivery-exception-resolution">
      <bpmndi:BPMNShape id="Shape_Start" bpmnElement="StartEvent_Intake">
        <dc:Bounds x="162" y="250" width="36" height="36" />
