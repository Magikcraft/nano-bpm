# Build artifacts produced by scripts/generate.sh — regenerate with `make generate`.
build/
generated/
target/

# Generated stub trait implementations (produced by scripts/gen-stub-server.py).
server/src/stub_impls.rs

# Persistence journals written by the server (set via NANOBPMN_JOURNAL).
*.journal

# Runtime data directory (NANOBPMN_DATA_DIR: read-model DB + journal).
.data/

# Console workspace (NANOBPMN_WORKSPACE_DIR: authoring source of truth — BPMN
# models + worker code). User content, not committed.
nanobpm-workspace/
