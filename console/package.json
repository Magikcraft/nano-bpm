{
  "name": "nanobpmn-console",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Web console for the self-contained single-node nanobpmn distribution: cluster/topology view, BPMN modeler, process-instance explorer, and embedded workers.",
  "scripts": {
    "dev": "vite",
    "gen:api": "openapi-ts",
    "build": "npm run gen:api && node scripts/copy-swagger.mjs && node scripts/copy-asyncapi.mjs && node scripts/build-docs.mjs && node scripts/build-whitepaper.mjs && tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@bpmn-io/form-js": "^1.21.3",
    "@bpmn-io/properties-panel": "^3.44.1",
    "@monaco-editor/react": "^4.7.0",
    "@nanobpm/nano-app-schema": "file:../spec-app",
    "@tanstack/react-query": "^5.59.0",
    "@typescript/ata": "^0.9.8",
    "bpmn-js": "^17.11.1",
    "bpmn-js-element-templates": "^2.27.0",
    "bpmn-js-properties-panel": "^5.59.0",
    "camunda-bpmn-js-behaviors": "^1.18.0",
    "dmn-js": "^17.8.1",
    "markdown-it": "^14.2.0",
    "monaco-editor": "^0.52.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.27.0",
    "zeebe-bpmn-moddle": "^1.15.0"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^10.1.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "js-yaml": "^4.3.0",
    "swagger-ui-dist": "^5.32.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
