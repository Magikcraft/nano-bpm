<!-- verdict: reject | category: InvalidTaskDefinition -->
<!-- zeebe-cells: validation:ZeebeElementValidator:attribute-must-be-present-and-not-empty -->
<!-- oracle: ZeebeElementValidator hasNonEmptyAttribute — zeebe:taskDefinition type must be non-empty (#856). -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0">
  <bpmn:process id="reject_empty_task_definition" isExecutable="true">
    <bpmn:startEvent id="s"><bpmn:outgoing>f0</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="task">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="" />
      </bpmn:extensionElements>
      <bpmn:incoming>f0</bpmn:incoming>
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="e"><bpmn:incoming>f1</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="f0" sourceRef="s" targetRef="task" />
    <bpmn:sequenceFlow id="f1" sourceRef="task" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
