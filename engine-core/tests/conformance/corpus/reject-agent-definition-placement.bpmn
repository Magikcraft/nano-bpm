<!-- verdict: reject | category: InvalidAgentDefinition -->
<!-- oracle: AgentDefinitionValidator — agentType="aiAgentSubProcess" is only valid on a bpmn:adHocSubProcess, not a serviceTask (agent-instance-parity S1). -->
