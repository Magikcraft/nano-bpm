<!-- verdict: diverge | category: UnsupportedUserTaskFormBinding -->
<!-- oracle: INTENTIONAL Nano/Zeebe divergence, not parity. Zeebe implements the
     `deployment` and `versionTag` user-task form bindings and ACCEPTS this model;
     Nano implements only `latest` and rejects the deploy loudly rather than
     silently degrading the binding to `latest` (#1190). Tagged `diverge` (not
     `reject`) so the conformance oracle never falsely claims Zeebe rejected a
     model it accepts. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0">
  <bpmn:process id="diverge_unsupported_user_task_form_binding" isExecutable="true">
    <bpmn:startEvent id="s"><bpmn:outgoing>f0</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="task">
      <bpmn:extensionElements>
        <zeebe:userTask />
        <zeebe:formDefinition formId="review-form" bindingType="deployment" />
      </bpmn:extensionElements>
      <bpmn:incoming>f0</bpmn:incoming>
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="e"><bpmn:incoming>f1</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="f0" sourceRef="s" targetRef="task" />
    <bpmn:sequenceFlow id="f1" sourceRef="task" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
