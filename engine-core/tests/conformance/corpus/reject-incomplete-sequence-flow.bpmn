<!-- verdict: reject | category: IncompleteSequenceFlow -->
<!-- oracle: a <sequenceFlow> must declare sourceRef and targetRef; Zeebe rejects an incomplete flow. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL">
  <bpmn:process id="reject_incomplete_sequence_flow" isExecutable="true">
    <bpmn:startEvent id="s"><bpmn:outgoing>f0</bpmn:outgoing></bpmn:startEvent>
    <bpmn:endEvent id="e"><bpmn:incoming>f0</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="f0" targetRef="e" />
  </bpmn:process>
</bpmn:definitions>
