<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:escalation id="Escalation_OVERLOAD" escalationCode="OVERLOAD"/>
  <bpmn:process id="escalate" isExecutable="true">
    <bpmn:boundaryEvent id="boundary" name="Boundary" attachedToRef="sub">
      <bpmn:escalationEventDefinition escalationRef="Escalation_OVERLOAD"/>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="done" name="Done"/>
    <bpmn:serviceTask id="handle" name="Handle">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="handle"/>
      </bpmn:extensionElements>
    </bpmn:serviceTask>
    <bpmn:endEvent id="handler_end" name="Handler End"/>
    <bpmn:startEvent id="s" name="S"/>
    <bpmn:subProcess id="sub" name="Sub">
    <bpmn:endEvent id="sub_end" name="Sub End"/>
    <bpmn:startEvent id="sub_start" name="Sub Start"/>
    <bpmn:intermediateThrowEvent id="throw" name="Throw">
      <bpmn:escalationEventDefinition escalationRef="Escalation_OVERLOAD"/>
    </bpmn:intermediateThrowEvent>
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="boundary" targetRef="handle"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="handle" targetRef="handler_end"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="s" targetRef="sub"/>
    <bpmn:sequenceFlow id="Flow_4" sourceRef="sub" targetRef="done"/>
    <bpmn:sequenceFlow id="Flow_5" sourceRef="sub_start" targetRef="throw"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="throw" targetRef="sub_end"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="escalate">
      <bpmndi:BPMNShape id="boundary_di" bpmnElement="boundary">
        <dc:Bounds x="360" y="122" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="done_di" bpmnElement="done">
        <dc:Bounds x="522" y="82" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="handle_di" bpmnElement="handle">
        <dc:Bounds x="485" y="170" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="handler_end_di" bpmnElement="handler_end">
        <dc:Bounds x="712" y="192" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="s_di" bpmnElement="s">
        <dc:Bounds x="142" y="82" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sub_di" bpmnElement="sub">
        <dc:Bounds x="295" y="60" width="110" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sub_end_di" bpmnElement="sub_end">
        <dc:Bounds x="522" y="302" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="sub_start_di" bpmnElement="sub_start">
        <dc:Bounds x="142" y="192" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="throw_di" bpmnElement="throw">
        <dc:Bounds x="332" y="192" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_1_di" bpmnElement="Flow_1">
        <di:waypoint x="378" y="158"/>
        <di:waypoint x="467" y="158"/>
        <di:waypoint x="467" y="210"/>
        <di:waypoint x="485" y="210"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_2_di" bpmnElement="Flow_2">
        <di:waypoint x="595" y="210"/>
        <di:waypoint x="712" y="210"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_3_di" bpmnElement="Flow_3">
        <di:waypoint x="178" y="100"/>
        <di:waypoint x="295" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_4_di" bpmnElement="Flow_4">
        <di:waypoint x="405" y="100"/>
        <di:waypoint x="522" y="100"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_5_di" bpmnElement="Flow_5">
        <di:waypoint x="178" y="210"/>
        <di:waypoint x="332" y="210"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_6_di" bpmnElement="Flow_6">
        <di:waypoint x="350" y="228"/>
        <di:waypoint x="350" y="320"/>
        <di:waypoint x="504" y="320"/>
        <di:waypoint x="522" y="320"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
