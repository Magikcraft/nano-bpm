<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_escalation" targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:escalation id="Esc" name="Overload" escalationCode="OVERLOAD" />
  <bpmn:process id="escalate" isExecutable="true">
    <bpmn:startEvent id="s">
      <bpmn:outgoing>f1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:intermediateThrowEvent id="Thr">
      <bpmn:incoming>f1</bpmn:incoming>
      <bpmn:outgoing>f2</bpmn:outgoing>
      <bpmn:escalationEventDefinition escalationRef="Esc" />
    </bpmn:intermediateThrowEvent>
    <bpmn:endEvent id="e">
      <bpmn:incoming>f2</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f1" sourceRef="s" targetRef="Thr" />
    <bpmn:sequenceFlow id="f2" sourceRef="Thr" targetRef="e" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_escalation">
    <bpmndi:BPMNPlane id="Plane_escalation" bpmnElement="escalate">
      <bpmndi:BPMNShape id="s_di" bpmnElement="s">
        <dc:Bounds x="150" y="100" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Thr_di" bpmnElement="Thr">
        <dc:Bounds x="250" y="100" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="e_di" bpmnElement="e">
        <dc:Bounds x="350" y="100" width="36" height="36"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="f1_di" bpmnElement="f1">
        <di:waypoint x="186" y="118"/>
        <di:waypoint x="250" y="118"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="f2_di" bpmnElement="f2">
        <di:waypoint x="286" y="118"/>
        <di:waypoint x="350" y="118"/>
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
