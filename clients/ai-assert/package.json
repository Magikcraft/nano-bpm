{
  "name": "@nanobpm/ai-assert",
  "version": "0.1.0",
  "description": "AI-judge and semantic-similarity test assertions (assertThatText) with deterministic record/replay. Framework- and engine-agnostic: no Nano engine, no Urban runtime — just an assertion surface over pluggable chat/embedding model seams, with opt-in real OpenAI/Transformers adapters. Lifted out of @nanobpm/urban-testkit so it is reusable anywhere.",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "nanobpm",
    "testing",
    "assertions",
    "ai",
    "llm",
    "judge",
    "semantic-similarity",
    "embeddings",
    "record-replay"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Magikcraft/nano-bpm.git",
    "directory": "clients/ai-assert"
  },
  "homepage": "https://github.com/Magikcraft/nano-bpm/tree/main/clients/ai-assert#readme",
  "bugs": {
    "url": "https://github.com/Magikcraft/nano-bpm/issues"
  },
  "engines": {
    "node": ">=22.6"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./source": "./src/index.ts"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "!src/**/*.test.ts",
    "!src/**/__guards__",
    "!src/**/__cassettes__"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\""
  },
  "peerDependencies": {
    "@xenova/transformers": "^2.17.2",
    "openai": "^4.67.3"
  },
  "peerDependenciesMeta": {
    "@xenova/transformers": {
      "optional": true
    },
    "openai": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3"
  }
}
