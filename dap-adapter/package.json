{
  "name": "@nanobpm/dap-adapter",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Debug Adapter Protocol adapter driving the nanobpmn wasm engine's stepping/breakpoint surface (issue #651).",
  "license": "Apache-2.0",
  "bin": {
    "nanobpmn-dap": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./events": {
      "types": "./dist/events.d.ts",
      "default": "./dist/events.js"
    },
    "./sourceMap": {
      "types": "./dist/sourceMap.d.ts",
      "default": "./dist/sourceMap.js"
    },
    "./session": {
      "types": "./dist/session.d.ts",
      "default": "./dist/session.js"
    }
  },
  "files": [
    "dist",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "pretest": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@nanobpm/engine-wasm": "file:../engine-wasm/pkg",
    "@vscode/debugadapter": "^1.68.0",
    "@vscode/debugprotocol": "^1.68.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@vscode/debugadapter-testsupport": "^1.68.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
