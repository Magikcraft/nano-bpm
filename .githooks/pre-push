#!/bin/sh
# Pre-push gate: run the pinned-nightly rustfmt check that CI enforces, so a
# formatting drift is caught locally instead of failing the `rustfmt (pinned
# nightly)` CI job after the push.
#
# Install with `make install-hooks` (sets core.hooksPath to this directory).
# Bypass in an emergency with `git push --no-verify`.
set -e

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# rustfmt must resolve the server crate's module tree, which includes the
# gitignored codegen module `stub_impls`. In a built tree the real file exists;
# if it does not (e.g. a fresh clone before the first build) drop a throwaway
# one-line stub for the parse-only check and remove it afterwards, exactly as
# the CI fmt job does — never clobbering a real generated file.
#
# The cleanup runs from a `trap` so an interrupt (Ctrl-C during fmt-check) or any
# early exit still removes a stub we created. Without it, a leaked placeholder is
# left behind with a fresh mtime, which defeats the Makefile's timestamp-based
# regeneration of stub_impls.rs and makes the next build compile the placeholder
# (the FORCE-stub-check guard on the $(STUB_IMPLS) rule is the Makefile-side
# backstop that re-checks the content and regenerates regardless of mtime).
stub="server/src/stub_impls.rs"
created_stub=0
cleanup() {
	if [ "$created_stub" -eq 1 ]; then
		rm -f "$stub"
	fi
	return 0
}
trap cleanup EXIT INT TERM
if [ ! -f "$stub" ]; then
	printf '// fmt stub\n' > "$stub"
	created_stub=1
fi

status=0
make fmt-check || status=$?

if [ "$status" -ne 0 ]; then
	echo "" >&2
	echo "pre-push: rustfmt check failed (this is the same gate CI runs)." >&2
	echo "  Fix with:   make fmt" >&2
	echo "  Then:       git add -u && git commit --amend --no-edit  (or a new commit)" >&2
	echo "  Bypass:     git push --no-verify   (not recommended — CI will still fail)" >&2
	exit 1
fi
