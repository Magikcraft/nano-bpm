<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="nano-workforce-defs" targetNamespace="https://nanobpm.io/workforce">
  <bpmn:message id="msg-task-requested" name="workforce.task-requested" />
  <bpmn:message id="msg-crewmate-status" name="workforce.crewmate-status" />
  <bpmn:process id="crew-task" name="Crew Task" isExecutable="true">
    <bpmn:startEvent id="start-requested" name="Task requested">
      <bpmn:outgoing>f-start-dispatch</bpmn:outgoing>
      <bpmn:messageEventDefinition id="med-requested" messageRef="msg-task-requested" />
    </bpmn:startEvent>
    <bpmn:businessRuleTask id="dispatch" name="Dispatch decision">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="workforce-dispatch" resultVariable="dispatch" />
      </bpmn:extensionElements>
      <bpmn:incoming>f-start-dispatch</bpmn:incoming>
      <bpmn:outgoing>f-dispatch-claim</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:serviceTask id="claim" name="Acquire worktree lease">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="workforce.claim" />
      </bpmn:extensionElements>
      <bpmn:incoming>f-dispatch-claim</bpmn:incoming>
      <bpmn:outgoing>f-claim-run</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="run-crewmate" name="Run crewmate">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="workforce.run-crewmate" />
      </bpmn:extensionElements>
      <bpmn:incoming>f-claim-run</bpmn:incoming>
      <bpmn:incoming>f-inspect-run</bpmn:incoming>
      <bpmn:outgoing>f-run-outcome</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:boundaryEvent id="wedge-timer" name="Stale / wedged" cancelActivity="false" attachedToRef="run-crewmate">
      <bpmn:outgoing>f-wedge-inspect</bpmn:outgoing>
      <bpmn:timerEventDefinition id="ted-wedge">
        <bpmn:timeDuration>PT10M</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:userTask id="inspect" name="Inspect wedged crewmate">
      <bpmn:incoming>f-wedge-inspect</bpmn:incoming>
      <bpmn:outgoing>f-inspect-run</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw-outcome" name="Outcome?">
      <bpmn:incoming>f-run-outcome</bpmn:incoming>
      <bpmn:outgoing>f-outcome-mode</bpmn:outgoing>
      <bpmn:outgoing>f-outcome-report</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="gw-mode" name="Mode?">
      <bpmn:incoming>f-outcome-mode</bpmn:incoming>
      <bpmn:outgoing>f-mode-validate</bpmn:outgoing>
      <bpmn:outgoing>f-mode-approve</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:callActivity id="validate" name="Validate (no-mistakes)">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="workforce-validate" />
      </bpmn:extensionElements>
      <bpmn:incoming>f-mode-validate</bpmn:incoming>
      <bpmn:outgoing>f-validate-approve</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:exclusiveGateway id="gw-approve-join">
      <bpmn:incoming>f-mode-approve</bpmn:incoming>
      <bpmn:incoming>f-validate-approve</bpmn:incoming>
      <bpmn:outgoing>f-join-approve</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="approve-merge" name="Approve merge?">
      <bpmn:incoming>f-join-approve</bpmn:incoming>
      <bpmn:outgoing>f-approve-land</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="land" name="Merge / land">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="workforce.land" />
      </bpmn:extensionElements>
      <bpmn:incoming>f-approve-land</bpmn:incoming>
      <bpmn:outgoing>f-land-teardown</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="write-report" name="Write report">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="workforce.write-report" />
      </bpmn:extensionElements>
      <bpmn:incoming>f-outcome-report</bpmn:incoming>
      <bpmn:outgoing>f-report-review</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="review-findings" name="Review findings">
      <bpmn:incoming>f-report-review</bpmn:incoming>
      <bpmn:outgoing>f-review-teardown</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="gw-teardown-join">
      <bpmn:incoming>f-land-teardown</bpmn:incoming>
      <bpmn:incoming>f-review-teardown</bpmn:incoming>
      <bpmn:outgoing>f-join-teardown</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="teardown" name="Teardown worktree">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="workforce.teardown" />
      </bpmn:extensionElements>
      <bpmn:incoming>f-join-teardown</bpmn:incoming>
      <bpmn:outgoing>f-teardown-done</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="end-done" name="Task done">
      <bpmn:incoming>f-teardown-done</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="f-start-dispatch" sourceRef="start-requested" targetRef="dispatch" />
    <bpmn:sequenceFlow id="f-dispatch-claim" sourceRef="dispatch" targetRef="claim" />
    <bpmn:sequenceFlow id="f-claim-run" sourceRef="claim" targetRef="run-crewmate" />
    <bpmn:sequenceFlow id="f-wedge-inspect" sourceRef="wedge-timer" targetRef="inspect" />
    <bpmn:sequenceFlow id="f-inspect-run" sourceRef="inspect" targetRef="run-crewmate" />
    <bpmn:sequenceFlow id="f-run-outcome" sourceRef="run-crewmate" targetRef="gw-outcome" />
    <bpmn:sequenceFlow id="f-outcome-mode" name="ship" sourceRef="gw-outcome" targetRef="gw-mode">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=shape = "ship"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-outcome-report" name="scout" sourceRef="gw-outcome" targetRef="write-report" />
    <bpmn:sequenceFlow id="f-mode-validate" name="no-mistakes" sourceRef="gw-mode" targetRef="validate">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=dispatch.mode = "no-mistakes"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="f-mode-approve" name="direct-PR / local-only" sourceRef="gw-mode" targetRef="gw-approve-join" />
    <bpmn:sequenceFlow id="f-validate-approve" sourceRef="validate" targetRef="gw-approve-join" />
    <bpmn:sequenceFlow id="f-join-approve" sourceRef="gw-approve-join" targetRef="approve-merge" />
    <bpmn:sequenceFlow id="f-approve-land" sourceRef="approve-merge" targetRef="land" />
    <bpmn:sequenceFlow id="f-land-teardown" sourceRef="land" targetRef="gw-teardown-join" />
    <bpmn:sequenceFlow id="f-report-review" sourceRef="write-report" targetRef="review-findings" />
    <bpmn:sequenceFlow id="f-review-teardown" sourceRef="review-findings" targetRef="gw-teardown-join" />
    <bpmn:sequenceFlow id="f-join-teardown" sourceRef="gw-teardown-join" targetRef="teardown" />
    <bpmn:sequenceFlow id="f-teardown-done" sourceRef="teardown" targetRef="end-done" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_crew-task">
    <bpmndi:BPMNPlane id="BPMNPlane_crew-task" bpmnElement="crew-task">
      <bpmndi:BPMNShape id="BPMNShape_start-requested" bpmnElement="start-requested">
        <dc:Bounds x="80" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="65" y="143" width="67" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_dispatch" bpmnElement="dispatch">
        <dc:Bounds x="216" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_claim" bpmnElement="claim">
        <dc:Bounds x="416" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_run-crewmate" bpmnElement="run-crewmate">
        <dc:Bounds x="616" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_inspect" bpmnElement="inspect">
        <dc:Bounds x="816" y="400" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_gw-outcome" bpmnElement="gw-outcome" isMarkerVisible="true">
        <dc:Bounds x="841" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="834" y="76" width="65" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_gw-mode" bpmnElement="gw-mode" isMarkerVisible="true">
        <dc:Bounds x="1041" y="95" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1045" y="76" width="43" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_validate" bpmnElement="validate">
        <dc:Bounds x="1216" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_gw-approve-join" bpmnElement="gw-approve-join" isMarkerVisible="true">
        <dc:Bounds x="1416" y="95" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_approve-merge" bpmnElement="approve-merge">
        <dc:Bounds x="1566" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_land" bpmnElement="land">
        <dc:Bounds x="1766" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_write-report" bpmnElement="write-report">
        <dc:Bounds x="1016" y="240" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_review-findings" bpmnElement="review-findings">
        <dc:Bounds x="1216" y="240" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_gw-teardown-join" bpmnElement="gw-teardown-join" isMarkerVisible="true">
        <dc:Bounds x="1966" y="95" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_teardown" bpmnElement="teardown">
        <dc:Bounds x="2116" y="80" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_end-done" bpmnElement="end-done">
        <dc:Bounds x="2316" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2301" y="143" width="66" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BPMNShape_wedge-timer" bpmnElement="wedge-timer">
        <dc:Bounds x="648" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="600" y="183" width="52" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="BPMNEdge_f-start-dispatch" bpmnElement="f-start-dispatch">
        <di:waypoint x="116" y="120" />
        <di:waypoint x="216" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f-dispatch-claim" bpmnElement="f-dispatch-claim">
        <di:waypoint x="316" y="120" />
        <di:waypoint x="416" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f-claim-run" bpmnElement="f-claim-run">
        <di:waypoint x="516" y="120" />
        <di:waypoint x="616" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f-run-outcome" bpmnElement="f-run-outcome">
        <di:waypoint x="716" y="120" />
        <di:waypoint x="841" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f-outcome-mode" bpmnElement="f-outcome-mode">
        <di:waypoint x="891" y="120" />
        <di:waypoint x="1041" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="950" y="98" width="32" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f-mode-validate" bpmnElement="f-mode-validate">
        <di:waypoint x="1091" y="120" />
        <di:waypoint x="1216" y="120" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1112" y="98" width="84" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f-validate-approve" bpmnElement="f-validate-approve">
        <di:waypoint x="1316" y="120" />
        <di:waypoint x="1416" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f-join-approve" bpmnElement="f-join-approve">
        <di:waypoint x="1466" y="120" />
        <di:waypoint x="1566" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f-approve-land" bpmnElement="f-approve-land">
        <di:waypoint x="1666" y="120" />
        <di:waypoint x="1766" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f-land-teardown" bpmnElement="f-land-teardown">
        <di:waypoint x="1866" y="120" />
        <di:waypoint x="1966" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f-join-teardown" bpmnElement="f-join-teardown">
        <di:waypoint x="2016" y="120" />
        <di:waypoint x="2116" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f-teardown-done" bpmnElement="f-teardown-done">
        <di:waypoint x="2216" y="120" />
        <di:waypoint x="2316" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f-outcome-report" bpmnElement="f-outcome-report">
        <di:waypoint x="866" y="145" />
        <di:waypoint x="866" y="280" />
        <di:waypoint x="1016" y="280" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="871" y="206" width="39" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f-mode-approve" bpmnElement="f-mode-approve">
        <di:waypoint x="1066" y="145" />
        <di:waypoint x="1066" y="180" />
        <di:waypoint x="1441" y="180" />
        <di:waypoint x="1441" y="145" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1213" y="185" width="82" height="28" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f-report-review" bpmnElement="f-report-review">
        <di:waypoint x="1116" y="280" />
        <di:waypoint x="1216" y="280" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f-review-teardown" bpmnElement="f-review-teardown">
        <di:waypoint x="1316" y="280" />
        <di:waypoint x="1991" y="280" />
        <di:waypoint x="1991" y="145" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f-wedge-inspect" bpmnElement="f-wedge-inspect">
        <di:waypoint x="666" y="178" />
        <di:waypoint x="666" y="440" />
        <di:waypoint x="816" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="BPMNEdge_f-inspect-run" bpmnElement="f-inspect-run">
        <di:waypoint x="916" y="440" />
        <di:waypoint x="2372" y="440" />
        <di:waypoint x="2372" y="60" />
        <di:waypoint x="666" y="60" />
        <di:waypoint x="666" y="80" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
